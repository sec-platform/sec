ess.check_output(["git", *args], text=True).strip()

root = Path.cwd().resolve()
# The transport commit adds only this task's temporary payload/workflow on top of the exact branch baseline.
parent = git("rev-parse", "HEAD^")
if git("rev-parse", f"{parent}^{tree}") != EXPECTED_BASE_TREE:
    raise SystemExit("unexpected parent tree")
packed = base64.b64decode(PAYLOAD, validate=True)
if hashlib.sha256(packed).hexdigest() != EXPECTED_PAYLOAD_SHA256:
    raise SystemExit("payload digest mismatch")
with tempfile.TemporaryDirectory(prefix="sec086-final-") as td:
    temp = Path(td)
    raw = lzma.decompress(packed)
    with tarfile.open(fileobj=io.BytesIO(raw), mode="r:") as tf:
        names = set(tf.getnames())
        if names != {"move.py", "split.py", "purify.py", "residual.patch"}:
            raise SystemExit(f"unexpected payload members: {sorted(names)}")
        tf.extractall(temp, filter="data")
    for name in ("move.py", "split.py", "purify.py"):
        subprocess.run(["python3", str(temp / name)], cwd=root, check=True)
    subprocess.run(["git", "apply", "--index", "--binary", str(temp / "residual.patch")], cwd=root, check=True)
# Retire only the task-owned transport inputs before evaluating the final tree.
for rel in (".github/sec086-final-transfer/apply.py", ".github/workflows/sec086-final-apply.yml"):
    p = root / rel
    if p.exists():
        p.unlink()
subprocess.run(["git", "add", "-A"], cwd=root, check=True)
subprocess.run(["git", "diff", "--cached", "--check"], cwd=root, check=True)
tree = git("write-tree")
if tree != EXPECTED_FINAL_TREE:
    raise SystemExit(f"final tree mismatch: {tree} != {EXPECTED_FINAL_TREE}")
roots = sorted(p.name for p in (root / "src").iterdir() if p.is_dir())
expected = sorted(["contracts","workspace","semantics","compiler","assurance","application","execution","adapters","entry","bootstrap"])
if roots != expected:
    raise SystemExit(f"unexpected src roots: {roots}")
print(f"exact final tree verified: {tree}")
