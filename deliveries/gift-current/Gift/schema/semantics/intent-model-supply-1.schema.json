{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gift:design-schema:intent-model-supply-1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "supplyId",
    "revision",
    "methods"
  ],
  "properties": {
    "schema": {
      "const": "gift.intent-model-supply/1"
    },
    "supplyId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parameters",
          "precondition",
          "edits",
          "scope",
          "meaningImports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "precondition": {
            "type": "object"
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "role",
                "field"
              ],
              "properties": {
                "op": {
                  "enum": [
                    "set",
                    "addInt"
                  ]
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {},
                "delta": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)$"
                }
              }
            }
          },
          "scope": {
            "const": "finite-model-only"
          },
          "claimedCoverage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "meaningImports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "libraryId",
                "revision",
                "contentDigest"
              ],
              "properties": {
                "libraryId": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "contentDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
