{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gift:design-schema:intent-module-mixed-1",
  "title": "Gift author-module mixed four-kind design-only structural shape",
  "description": "DESIGN-ONLY structural subset for intent:goal/1, semantic:pattern/1, semantic:pattern-use/2 and req:composite/1. Optional workspace/locked import occurrence shapes are checked; actual export/lock/Meaning qualification needs a real consumer. Does not alter gift.author-module/1 or legacy intent-module-1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "moduleId",
    "namespace",
    "dialects",
    "definitions"
  ],
  "properties": {
    "schema": {
      "const": "gift.author-module/1"
    },
    "moduleId": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "dialects": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "languageId",
            "constraint"
          ],
          "properties": {
            "languageId": {
              "const": "gift.intent"
            },
            "constraint": {
              "const": "1"
            }
          }
        },
        "semanticPattern": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "languageId",
            "constraint"
          ],
          "properties": {
            "languageId": {
              "const": "gift.semantic-pattern"
            },
            "constraint": {
              "const": "1"
            }
          }
        },
        "semanticPatternUse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "languageId",
            "constraint"
          ],
          "properties": {
            "languageId": {
              "const": "gift.semantic-pattern-use"
            },
            "constraint": {
              "const": "2"
            }
          }
        },
        "req": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "languageId",
            "constraint"
          ],
          "properties": {
            "languageId": {
              "const": "gift.requirement-structure"
            },
            "constraint": {
              "const": "1"
            }
          }
        }
      }
    },
    "definitions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "body"
            ],
            "properties": {
              "kind": {
                "const": "intent:goal"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "$ref": "urn:gift:design-schema:intent-body-1"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "body"
            ],
            "properties": {
              "kind": {
                "const": "semantic:pattern"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "$ref": "urn:gift:design-schema:semantic-pattern-1"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "body"
            ],
            "properties": {
              "kind": {
                "const": "semantic:pattern-use"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "$ref": "urn:gift:design-schema:semantic-pattern-use-2"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "body"
            ],
            "properties": {
              "kind": {
                "const": "req:composite"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "$ref": "urn:gift:design-schema:requirement-structure-1"
              }
            }
          }
        ]
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definitionId"
        ],
        "properties": {
          "definitionId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "imports": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^:\\u0000-\\u001f\\u007f]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "moduleId"
            ],
            "properties": {
              "mode": {
                "const": "workspace"
              },
              "moduleId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "moduleId"
            ],
            "properties": {
              "mode": {
                "const": "locked"
              },
              "moduleId": {
                "type": "string",
                "minLength": 1
              },
              "constraint": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "annotations": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$comment": "Module-level import declarations have shape only; no proof of module binding or externally qualified dialect. This remains a design-only finite validator; full codec implementation must preserve unknown content, provenance, and type/ref checking."
}
