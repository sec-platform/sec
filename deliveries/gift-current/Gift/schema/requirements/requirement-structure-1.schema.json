{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gift:design-schema:requirement-structure-1",
  "title": "gift.requirement-structure/1 composite body",
  "$comment": "Normative design structure only. Exact semantic references, qualification, authorization, filesystem identity and runtime effects require their declared consumers. Not a production implementation claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parameters",
    "terms"
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Parameter"
      },
      "minProperties": 0
    },
    "subjects": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "$ref": "#/$defs/Type"
          }
        }
      },
      "minProperties": 0
    },
    "exposes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter"
            ],
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "minItems": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject"
            ],
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "minItems": 0
              }
            }
          }
        ]
      },
      "minProperties": 0
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Term"
      },
      "minItems": 0
    }
  },
  "$defs": {
    "Json": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Json"
          },
          "minItems": 0
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        }
      ]
    },
    "DefinitionRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definitionId"
          ],
          "properties": {
            "definitionId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "import",
            "export"
          ],
          "properties": {
            "import": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "export": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        }
      ]
    },
    "Type": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "$ref": "#/$defs/DefinitionRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "list"
          ],
          "properties": {
            "list": {
              "$ref": "#/$defs/Type"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "builtin"
          ],
          "properties": {
            "builtin": {
              "enum": [
                "Bool",
                "Int",
                "Text"
              ]
            }
          }
        }
      ]
    },
    "Value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parameter"
          ],
          "properties": {
            "parameter": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "minItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject"
          ],
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "minItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bound"
          ],
          "properties": {
            "bound": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "minItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enum"
          ],
          "properties": {
            "enum": {
              "$ref": "#/$defs/DefinitionRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typed"
          ],
          "properties": {
            "typed": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "$ref": "#/$defs/Type"
                },
                "value": {
                  "$ref": "#/$defs/Json"
                }
              }
            }
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Value"
          },
          "minItems": 0
        }
      ]
    },
    "ClosedValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enum"
          ],
          "properties": {
            "enum": {
              "$ref": "#/$defs/DefinitionRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typed"
          ],
          "properties": {
            "typed": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "$ref": "#/$defs/Type"
                },
                "value": {
                  "$ref": "#/$defs/Json"
                }
              }
            }
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClosedValue"
          },
          "minItems": 0
        }
      ]
    },
    "Parameter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "type"
          ],
          "properties": {
            "role": {
              "const": "subject"
            },
            "type": {
              "$ref": "#/$defs/Type"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "type"
          ],
          "properties": {
            "role": {
              "const": "value"
            },
            "type": {
              "$ref": "#/$defs/Type"
            },
            "default": {
              "$ref": "#/$defs/ClosedValue"
            }
          }
        }
      ]
    },
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/Value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "equal"
          ],
          "properties": {
            "equal": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/Value"
                },
                {
                  "$ref": "#/$defs/Value"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/Condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "minItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "minItems": 0
            }
          }
        }
      ]
    },
    "Term": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "use",
            "arguments"
          ],
          "properties": {
            "use": {
              "$ref": "#/$defs/DefinitionRef"
            },
            "arguments": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "minProperties": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "require",
            "fields"
          ],
          "properties": {
            "require": {
              "$ref": "#/$defs/DefinitionRef"
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "minProperties": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prefer",
            "fields"
          ],
          "properties": {
            "prefer": {
              "$ref": "#/$defs/DefinitionRef"
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "minProperties": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Term"
              },
              "minItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Term"
              },
              "minItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when"
          ],
          "properties": {
            "when": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "condition",
                "then"
              ],
              "properties": {
                "condition": {
                  "$ref": "#/$defs/Condition"
                },
                "then": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Term"
                  },
                  "minItems": 0
                },
                "else": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Term"
                  },
                  "minItems": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forEach"
          ],
          "properties": {
            "forEach": {
              "$ref": "#/$defs/Quantifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exists"
          ],
          "properties": {
            "exists": {
              "$ref": "#/$defs/Quantifier"
            }
          }
        }
      ]
    },
    "Quantifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bind",
        "in",
        "body"
      ],
      "properties": {
        "bind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "in": {
          "$ref": "#/$defs/Value"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Term"
          },
          "minItems": 0
        },
        "itemType": {
          "$ref": "#/$defs/Type"
        }
      }
    }
  }
}
