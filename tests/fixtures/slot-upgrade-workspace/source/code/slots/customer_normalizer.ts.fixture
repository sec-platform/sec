import type {
  CustomerInput,
  NormalizedCustomerInput
} from '../../../project/src/runtime/database.ts';

export function normalizeCustomer(input: CustomerInput): NormalizedCustomerInput {
  return {
    name: String(input.name ?? ''),
    email: String(input.email ?? ''),
    phone: String(input.phone ?? ''),
    company: String(input.company ?? '')
  };
}
