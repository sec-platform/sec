{
  "name": "engineering-compiler",
  "version": "0.1.0",
  "description": "Local-first Engineering Workspace Compiler for governed, verifiable software evolution.",
  "license": "MPL-2.0",
  "author": "Jeremy Yang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sec-platform/sec.git"
  },
  "bugs": {
    "url": "https://github.com/sec-platform/sec/issues"
  },
  "homepage": "https://github.com/sec-platform/sec#readme",
  "keywords": [
    "compiler",
    "developer-tools",
    "software-engineering",
    "local-first",
    "ai-assisted-development"
  ],
  "private": true,
  "type": "module",
  "source": "./src/bootstrap/cli/cli.ts",
  "packageManager": "bun@1.4.0",
  "bin": {
    "sec": "./dist/index.js"
  },
  "scripts": {
    "sec": "\"$npm_execpath\" ./src/adapters/toolchain/runtime/package-source-launcher.ts",
    "dev": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts",
    "dev:status": "\"$npm_execpath\" src/adapters/self-hosting/control/documentation/document-control-plane.ts status",
    "dev:continue": "\"$npm_execpath\" src/adapters/self-hosting/control/continuation/local-continuation.ts continue",
    "sec:closeout": "\"$npm_execpath\" src/adapters/self-hosting/control/composition/trusted-runtime-closeout.ts",
    "sec:runtime-canary": "\"$npm_execpath\" src/adapters/self-hosting/control/composition/trusted-runtime-closeout.ts --runtime-canary",
    "build": "\"$npm_execpath\" ./src/bootstrap/release/build.ts",
    "release:build": "\"$npm_execpath\" ./src/bootstrap/release/build-set.ts",
    "typecheck": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts typecheck",
    "reference:refresh": "\"$npm_execpath\" ./src/bootstrap/reference/compile-workspace.ts",
    "reference:check": "\"$npm_execpath\" run sec -- reference check",
    "demo:quickstart": "\"$npm_execpath\" ./src/bootstrap/reference/demo.ts quickstart",
    "demo:governance": "\"$npm_execpath\" ./src/bootstrap/reference/demo.ts governance",
    "demo:closed-loop": "\"$npm_execpath\" ./src/bootstrap/reference/demo.ts closed-loop",
    "dogfood:reference": "\"$npm_execpath\" run reference:refresh",
    "dogfood:governance": "\"$npm_execpath\" run dogfood:reference && \"$npm_execpath\" run sec -- artifacts --paths --json --kind governance",
    "test": "\"$npm_execpath\" run test:fast",
    "test:affected": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts test:affected",
    "test:fast": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts test:fast",
    "test:slow": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts test:slow",
    "test:full": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts test",
    "test:budget": "\"$npm_execpath\" run sec -- test budget --json",
    "imports:check": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts imports:check",
    "imports:apply": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts imports:apply",
    "imports:freeze": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts imports:freeze",
    "deps:ensure": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts deps:ensure",
    "hooks:install": "\"$npm_execpath\" ./src/adapters/self-hosting/development/hooks/install.ts",
    "postinstall": "\"$npm_execpath\" ./src/adapters/self-hosting/development/hooks/install.ts --lifecycle",
    "unused": "\"$npm_execpath\" ./node_modules/knip/bin/knip.js --include files,dependencies,devDependencies,unlisted,exports,types",
    "unused:production": "\"$npm_execpath\" ./node_modules/knip/bin/knip.js --production --include files,exports,types",
    "jscpd": "\"$npm_execpath\" ./node_modules/jscpd/run-jscpd.js src/ tests/ --reporters console --format typescript,tsx,javascript,jsx --cross-formats js-ts --ignore \"**/node_modules/**,**/dist/**,.tmp/**\" --max-lines 100000 --max-size 2mb --min-lines 5 --min-tokens 50 --absolute",
    "audit:static": "\"$npm_execpath\" run audit:source-program",
    "audit:module-topology": "\"$npm_execpath\" src/adapters/repository/repository-audit/cli.ts --worktree-module-topology --enforce",
    "audit:source-program": "\"$npm_execpath\" src/adapters/repository/repository-audit/cli.ts --worktree-source-program --enforce",
    "audit:repository": "\"$npm_execpath\" src/adapters/repository/repository-audit/cli.ts --json",
    "text:census": "\"$npm_execpath\" run sec -- text census --json",
    "environment:settle": "\"$npm_execpath\" run sec -- environment settle",
    "environment:settle:fix": "\"$npm_execpath\" run sec -- environment settle --fix",
    "docs:package": "\"$npm_execpath\" ./src/bootstrap/release/build-documentation.ts",
    "docs:refresh": "\"$(\"$npm_execpath\" --print \"process.platform === 'win32' ? 'python' : 'python3'\")\" -B tools/source_inventory.py --write",
    "docs:doctor": "\"$(\"$npm_execpath\" --print \"process.platform === 'win32' ? 'python' : 'python3'\")\" -B -m unittest discover -s tools -p 'test_check_*.py' -q && \"$(\"$npm_execpath\" --print \"process.platform === 'win32' ? 'python' : 'python3'\")\" -B tools/check_docs.py && \"$npm_execpath\" src/adapters/verification/platform/provider/capability-ledger-validation.ts",
    "check": "\"$npm_execpath\" run check:fast",
    "check:affected": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts check:affected",
    "check:fast": "\"$npm_execpath\" ./src/adapters/self-hosting/development/runner/cli.ts check:fast",
    "check:full": "\"$npm_execpath\" run imports:check --all && \"$npm_execpath\" run audit:static && \"$npm_execpath\" run unused && \"$npm_execpath\" run jscpd && \"$npm_execpath\" run typecheck && \"$npm_execpath\" run docs:doctor && \"$npm_execpath\" run test:full"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "ora": "^9.4.1",
    "p-limit": "^7.3.2",
    "picocolors": "^1.1.1",
    "yaml": "2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "jscpd": "5.1.1",
    "knip": "6.34.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3"
  }
}
