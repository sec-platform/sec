{
  "name": "engineering-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "sec": "./dist/index.js"
  },
  "scripts": {
    "sec": "bun ./platform/cli/index.ts",
    "dev": "bun ./platform/dev-runner.ts",
    "build": "bun ./scripts/build-release.ts",
    "publish": "bun ./scripts/publish-public.ts",
    "typecheck": "bun ./platform/dev-runner.ts typecheck",
    "reference:refresh": "bun ./scripts/compile-reference-workspace.ts",
    "reference:check": "bun run sec -- reference check",
    "demo:quickstart": "bun run sec -- init --reset && bun run reference:refresh",
    "demo:governance": "bun run demo:quickstart && bun run sec -- artifacts --paths --kind governance",
    "demo:closed-loop": "bun run demo:quickstart && bun run sec -- verify --lane all && bun run sec -- artifacts --paths --kind governance && bun run sec -- explain --json --compact",
    "dogfood:reference": "bun run reference:refresh",
    "dogfood:governance": "bun run dogfood:reference && bun run sec -- artifacts --paths --json --kind governance",
    "test": "bun ./platform/dev-runner.ts test:fast",
    "test:affected": "bun ./platform/dev-runner.ts test:affected",
    "test:fast": "bun ./platform/dev-runner.ts test:fast",
    "test:slow": "bun ./platform/dev-runner.ts test:slow",
    "test:full": "bun ./platform/dev-runner.ts test",
    "test:budget": "bun run sec -- test budget --json",
    "test:contract-freeze": "bun ./platform/dev-runner.ts contract-freeze",
    "test:benchmark-contract": "bun run sec -- benchmark suite --json",
    "imports:check": "bun ./platform/dev-runner.ts imports:check",
    "imports:apply": "bun ./platform/dev-runner.ts imports:apply",
    "imports:freeze": "bun ./platform/dev-runner.ts imports:freeze",
    "deps:ensure": "bun ./platform/dev-runner.ts deps:ensure",
    "hooks:install": "bun ./scripts/install-git-hooks.ts",
    "postinstall": "bun ./scripts/install-git-hooks.ts --lifecycle",
    "depcruise": "bunx --bun dependency-cruiser@17.3.10 \"platform/**/*.ts\" --config .dependency-cruiser.json",
    "jscpd": "bunx --bun jscpd@4.0.9 platform/ scripts/ -o report/jscpd --reporters html,console,json --format typescript,javascript --ignore \"**/node_modules/**,**/dist/**,**/*.test.ts,**/*.d.ts,**/upgrade/**,.tmp/**\" --min-lines 5 --min-tokens 50 --absolute",
    "discover": "bun scripts/discover-all.ts --json --output report/discover.json",
    "audit:repository": "bun scripts/codex/repository-audit.ts --json",
    "text:census": "bun tooling/sec-dev/text/text-byte-census.ts --json",
    "environment:settle": "bun tooling/sec-dev/workspace/worktree-settlement.ts",
    "environment:settle:fix": "bun tooling/sec-dev/workspace/worktree-settlement.ts --fix",
    "docs:doctor": "bun docs/scripts/docs-doctor.ts",
    "gitnexus:analyze": "gitnexus analyze --skip-agents-md --no-stats",
    "gitnexus:status": "gitnexus status",
    "graphify": "uvx --from graphifyy==0.7.10 graphify",
    "graphify:update": "uvx --from graphifyy==0.7.10 graphify update .",
    "graphify:extract": "uvx --from graphifyy==0.7.10 graphify extract . --out report/graphify --no-cluster",
    "arch:check": "bun run depcruise && bun run jscpd",
    "preflight": "bun run depcruise && bun run jscpd && bun run discover",
    "clean:test-workspaces": "bun ./platform/dev-runner.ts clean-test-workspaces",
    "check": "bun run check:fast",
    "check:affected": "bun ./platform/dev-runner.ts check:affected",
    "check:fast": "bun ./platform/dev-runner.ts check:fast",
    "check:full": "bun run imports:check --all && bun run typecheck && bun run docs:doctor && bun run test:full"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "ejs": "^5.0.2",
    "globby": "^16.2.0",
    "lodash-es": "^4.18.1",
    "next": "16.2.4",
    "ora": "^9.4.0",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "semver": "^7.7.4",
    "yaml": "2.8.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/bun": "1.3.13",
    "@types/ejs": "^3.1.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/semver": "^7.7.1",
    "gitnexus": "1.6.3",
    "prettier": "^3.8.3",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3"
  },
  "trustedDependencies": [
    "@ladybugdb/core",
    "gitnexus",
    "onnxruntime-node",
    "protobufjs"
  ]
}
