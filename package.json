{
  "name": "engineering-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "platform": "node ./platform/cli/index.ts",
    "reference:refresh": "npm run platform -- resolve && npm run platform -- compose && npm run platform -- adapt && npm run platform -- verify --lane all && npm run platform -- lock && npm run platform -- explain",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bun": "bun test tests/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "platform:bun": "bun ./platform/cli/index.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
