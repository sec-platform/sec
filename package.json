{
  "name": "engineering-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "source": "./src/interface/cli/cli.ts",
  "packageManager": "bun@1.4.0",
  "bin": {
    "sec": "./dist/index.js"
  },
  "scripts": {
    "sec": "\"$npm_execpath\" ./src/toolchain/runtime/package-source-launcher.ts",
    "dev": "\"$npm_execpath\" ./src/development/runner/cli.ts",
    "dev:status": "\"$npm_execpath\" src/control/documentation/document-control-plane.ts status",
    "dev:continue": "\"$npm_execpath\" src/control/continuation/local-continuation.ts continue",
    "sec:closeout": "\"$npm_execpath\" src/control/branch-lifecycle/trusted-runtime-closeout.ts",
    "sec:main-health": "\"$npm_execpath\" src/control/branch-lifecycle/trusted-runtime-closeout.ts --main-health",
    "sec:runtime-canary": "\"$npm_execpath\" src/control/branch-lifecycle/trusted-runtime-closeout.ts --runtime-canary",
    "build": "\"$npm_execpath\" ./src/release/build.ts",
    "typecheck": "\"$npm_execpath\" ./src/development/runner/cli.ts typecheck",
    "reference:refresh": "\"$npm_execpath\" ./src/reference/compile-workspace.ts",
    "reference:check": "\"$npm_execpath\" run sec -- reference check",
    "demo:quickstart": "\"$npm_execpath\" ./src/reference/demo.ts quickstart",
    "demo:governance": "\"$npm_execpath\" ./src/reference/demo.ts governance",
    "demo:closed-loop": "\"$npm_execpath\" ./src/reference/demo.ts closed-loop",
    "dogfood:reference": "\"$npm_execpath\" run reference:refresh",
    "dogfood:governance": "\"$npm_execpath\" run dogfood:reference && \"$npm_execpath\" run sec -- artifacts --paths --json --kind governance",
    "test": "\"$npm_execpath\" run test:fast",
    "test:affected": "\"$npm_execpath\" ./src/development/runner/cli.ts test:affected",
    "test:fast": "\"$npm_execpath\" ./src/development/runner/cli.ts test:fast",
    "test:slow": "\"$npm_execpath\" ./src/development/runner/cli.ts test:slow",
    "test:full": "\"$npm_execpath\" ./src/development/runner/cli.ts test",
    "test:budget": "\"$npm_execpath\" run sec -- test budget --json",
    "test:contract-freeze": "\"$npm_execpath\" ./src/development/runner/cli.ts contract-freeze",
    "test:benchmark-contract": "\"$npm_execpath\" run sec -- benchmark suite --json",
    "imports:check": "\"$npm_execpath\" ./src/development/runner/cli.ts imports:check",
    "imports:apply": "\"$npm_execpath\" ./src/development/runner/cli.ts imports:apply",
    "imports:freeze": "\"$npm_execpath\" ./src/development/runner/cli.ts imports:freeze",
    "deps:ensure": "\"$npm_execpath\" ./src/development/runner/cli.ts deps:ensure",
    "hooks:install": "\"$npm_execpath\" ./src/development/hooks/install.ts",
    "postinstall": "\"$npm_execpath\" ./src/development/hooks/install.ts --lifecycle",
    "depcruise": "depcruise \"src/**/*.ts\" --config .dependency-cruiser.json",
    "unused": "knip --include files,dependencies,devDependencies,unlisted",
    "jscpd": "jscpd src/ --reporters console --format typescript,javascript --ignore \"**/node_modules/**,**/dist/**,**/*.test.ts,**/*.d.ts,**/upgrade/**,.tmp/**\" --min-lines 5 --min-tokens 50 --absolute",
    "audit:static": "\"$npm_execpath\" run audit:source-program && \"$npm_execpath\" run depcruise && \"$npm_execpath\" run unused && \"$npm_execpath\" run jscpd",
    "audit:module-topology": "\"$npm_execpath\" src/brownfield/repository-audit/cli.ts --worktree-module-topology --enforce",
    "audit:source-program": "\"$npm_execpath\" src/brownfield/repository-audit/cli.ts --worktree-source-program --enforce",
    "audit:repository": "\"$npm_execpath\" src/brownfield/repository-audit/cli.ts --json",
    "text:census": "\"$npm_execpath\" run sec -- text census --json",
    "environment:settle": "\"$npm_execpath\" run sec -- environment settle",
    "environment:settle:fix": "\"$npm_execpath\" run sec -- environment settle --fix",
    "docs:doctor": "\"$npm_execpath\" src/control/documentation/doctor/cli.ts",
    "check": "\"$npm_execpath\" run check:fast",
    "check:affected": "\"$npm_execpath\" ./src/development/runner/cli.ts check:affected",
    "check:fast": "\"$npm_execpath\" ./src/development/runner/cli.ts check:fast",
    "check:full": "\"$npm_execpath\" run imports:check --all && \"$npm_execpath\" run typecheck && \"$npm_execpath\" run docs:doctor && \"$npm_execpath\" run test:full"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "ora": "^9.4.1",
    "p-limit": "^7.3.2",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "yaml": "2.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/semver": "^7.8.0",
    "dependency-cruiser": "18.2.0",
    "jscpd": "5.1.1",
    "knip": "6.33.0",
    "prettier": "^3.9.6",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3"
  }
}
