{
  "name": "engineering-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "source": "./src/interface/cli/index.ts",
  "packageManager": "bun@1.3.14",
  "bin": {
    "sec": "./dist/index.js"
  },
  "scripts": {
    "sec": "bun ./src/interface/cli/index.ts",
    "dev": "bun ./src/development/runner/cli.ts",
    "dev:status": "bun src/control/documentation/document-control-plane.ts status",
    "dev:continue": "bun src/control/continuation/local-continuation.ts continue",
    "sec:closeout": "bun src/control/branch-lifecycle/trusted-runtime-closeout.ts",
    "sec:main-health": "bun src/control/branch-lifecycle/trusted-runtime-closeout.ts --main-health",
    "sec:runtime-canary": "bun src/control/branch-lifecycle/trusted-runtime-closeout.ts --runtime-canary",
    "build": "bun ./src/release/build.ts",
    "typecheck": "bun ./src/development/runner/cli.ts typecheck",
    "reference:refresh": "bun ./src/reference/compile-workspace.ts",
    "reference:check": "bun run sec -- reference check",
    "demo:quickstart": "bun ./src/reference/demo.ts quickstart",
    "demo:governance": "bun ./src/reference/demo.ts governance",
    "demo:closed-loop": "bun ./src/reference/demo.ts closed-loop",
    "dogfood:reference": "bun run reference:refresh",
    "dogfood:governance": "bun run dogfood:reference && bun run sec -- artifacts --paths --json --kind governance",
    "test": "bun run test:fast",
    "test:affected": "bun ./src/development/runner/cli.ts test:affected",
    "test:fast": "bun ./src/development/runner/cli.ts test:fast",
    "test:slow": "bun ./src/development/runner/cli.ts test:slow",
    "test:full": "bun ./src/development/runner/cli.ts test",
    "test:budget": "bun run sec -- test budget --json",
    "test:contract-freeze": "bun ./src/development/runner/cli.ts contract-freeze",
    "test:benchmark-contract": "bun run sec -- benchmark suite --json",
    "imports:check": "bun ./src/development/runner/cli.ts imports:check",
    "imports:apply": "bun ./src/development/runner/cli.ts imports:apply",
    "imports:freeze": "bun ./src/development/runner/cli.ts imports:freeze",
    "deps:ensure": "bun ./src/development/runner/cli.ts deps:ensure",
    "hooks:install": "bun ./src/development/hooks/install.ts",
    "postinstall": "bun ./src/development/hooks/install.ts --lifecycle",
    "depcruise": "depcruise \"src/**/*.ts\" --config .dependency-cruiser.json",
    "unused": "knip --include files,dependencies,devDependencies,unlisted",
    "jscpd": "jscpd src/ --reporters console --format typescript,javascript --ignore \"**/node_modules/**,**/dist/**,**/*.test.ts,**/*.d.ts,**/upgrade/**,.tmp/**\" --min-lines 5 --min-tokens 50 --absolute",
    "audit:static": "bun run audit:source-program && bun run depcruise && bun run unused && bun run jscpd",
    "audit:source-program": "bun src/brownfield/repository-audit/cli.ts --worktree-source-program --enforce",
    "audit:repository": "bun src/brownfield/repository-audit/cli.ts --json",
    "text:census": "bun run sec -- text census --json",
    "environment:settle": "bun run sec -- environment settle",
    "environment:settle:fix": "bun run sec -- environment settle --fix",
    "docs:doctor": "bun src/control/documentation/doctor/cli.ts",
    "check": "bun run check:fast",
    "check:affected": "bun ./src/development/runner/cli.ts check:affected",
    "check:fast": "bun ./src/development/runner/cli.ts check:fast",
    "check:full": "bun run imports:check --all && bun run typecheck && bun run docs:doctor && bun run test:full"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "ora": "^9.4.0",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "semver": "^7.7.4",
    "yaml": "2.8.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/bun": "1.3.13",
    "@types/node": "25.6.0",
    "@types/semver": "^7.7.1",
    "dependency-cruiser": "18.2.0",
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "prettier": "^3.8.3",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3"
  }
}
