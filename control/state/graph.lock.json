      ],
      "mockTemplate": "import type { Database, TicketCommentInput, TicketCommentRecord } from '../src/runtime/database.ts';\nimport type { Session } from '../src/installed/auth/session.ts';\n\nfunction assertTenantTicket(db: Database, ticketId: number, tenantId: string) {\n  const ticket = db.tickets.find((entry) => entry.id === ticketId);\n  if (!ticket || ticket.tenantId !== tenantId) {\n    throw new Error('Ticket is not available for this tenant');\n  }\n  return ticket;\n}\n\nexport function addTicketCommentDelegate(db: Database, session: Session, input: TicketCommentInput): TicketCommentRecord {\n  if (!input.body || !input.body.trim()) {\n    throw new Error('Ticket comment is required');\n  }\n  assertTenantTicket(db, input.ticketId, session.tenantId);\n  const comment: TicketCommentRecord = {\n    id: db.nextTicketCommentId++,\n    tenantId: session.tenantId,\n    ticketId: input.ticketId,\n    body: input.body.trim(),\n    authorId: session.userId,\n    createdAt: new Date(0).toISOString()\n  };\n  db.ticketComments.push(comment);\n  return comment;\n}\n\nexport function listTicketCommentsDelegate(db: Database, session: Session, ticketId: number): TicketCommentRecord[] {\n  assertTenantTicket(db, ticketId, session.tenantId);\n  return db.ticketComments.filter(c => c.tenantId === session.tenantId && c.ticketId === ticketId);\n}\n"
    }
