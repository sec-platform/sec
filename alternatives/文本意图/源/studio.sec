// 此文件是产品特有的作者源；standard.sec及其片段是可复用需求定义。
// sec/spec/* 的精确合同在随附规范中；本包未发布这些库的实现。
import "./standard.sec" as standard;
import "sec/spec/ide" as ide;
import "sec/spec/search" as search;
import "sec/spec/delivery" as delivery;
import "sec/spec/quality" as quality;

export design Studio(s: ide.Workbench) {
  use standard.LocalWorkbench(
    s,
    search.Reject,
    [delivery.Windows, delivery.Linux, delivery.MacOS]
  );
  prefer quality.Cost {
    on: s,
    metric: quality.ResidentMemory,
    priority: 1,
    workload: quality.DeclaredWorkload
  };
  prefer quality.Cost {
    on: s,
    metric: quality.InteractiveLatency,
    priority: 2,
    workload: quality.DeclaredWorkload
  };
}
