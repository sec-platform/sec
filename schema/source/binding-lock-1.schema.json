{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projectId",
    "resolutionInputs",
    "bindings",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "gift.binding-lock/1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "resolutionInputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Json"
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
      }
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
      },
      "additionalProperties": {
        "$ref": "#/$defs/Node"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Json"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gift:design-schema:binding-lock-1",
  "title": "gift.binding-lock/1 finite shape gate; design-only, not issuer or resolver",
  "description": "Only the top-level and node/digest field shape is checked. A fabricated node cannot prove actual content, access, authority, semantic qualification, true environment closure, signed evidence or replay safety.",
  "$defs": {
    "Json": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        }
      ]
    },
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subjectId",
        "revision",
        "content",
        "dependencies"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
        },
        "content": {
          "$ref": "#/$defs/Content"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
          }
        },
        "locationHint": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
        }
      }
    },
    "Content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "byteLength",
        "format"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
        },
        "manifest": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentMember"
          }
        }
      }
    },
    "ContentMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "byteLength",
        "algorithm",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      }
    }
  }
}
