              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "minItems": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject"
            ],
            "properties": {
