  "additionalProperties": false,
  "required": [
    "parameters",
    "terms"
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Parameter"
      },
      "minProperties": 0
    },
    "subjects": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
