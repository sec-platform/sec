              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "$ref": "#/$defs/Type"
                },
                "value": {
                  "$ref": "#/$defs/Json"
                }
