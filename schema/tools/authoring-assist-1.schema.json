{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gift:design-schema:authoring-assist-1",
  "title": "Negotiated Gift authoring assistance request/profile (design only)",
  "description": "The original query/propose are extended only on an exactly negotiated capability; no new public tools, write authorities or implicit editor commands.",
  "oneOf": [
    {
      "$ref": "#/$defs/AssistQuery"
    },
    {
      "$ref": "#/$defs/AuthorEdit"
    }
  ],
  "$defs": {
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "character"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "character": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/Position"
        },
        "end": {
          "$ref": "#/$defs/Position"
        }
      }
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "newName"
          ],
          "properties": {
            "kind": {
              "const": "rename"
            },
            "newName": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "newName"
          ],
          "properties": {
            "kind": {
              "const": "extract-function"
            },
            "newName": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "inline"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "organize-imports"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "format"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "move-file"
            },
            "to": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        }
      ]
    },
    "Assist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "positionEncoding"
      ],
      "properties": {
        "kind": {
          "enum": [
            "describe",
            "complete",
            "signature",
            "definition",
            "references",
            "implementations",
            "actions"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "positionEncoding": {
          "enum": [
            "utf-8",
            "utf-16",
            "utf-32"
          ]
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "range": {
          "$ref": "#/$defs/Range"
        },
        "action": {
          "$ref": "#/$defs/Action"
        }
      },
      "oneOf": [
        {
          "required": [
            "position"
          ],
          "not": {
            "required": [
              "range"
            ]
          }
        },
        {
          "required": [
            "range"
          ],
          "not": {
            "required": [
              "position"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "complete",
                  "signature",
                  "definition",
                  "references",
                  "implementations"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "position"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "range"
                  ]
                },
                {
                  "required": [
                    "action"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "actions"
              }
            },
            "required": [
              "kind"
            ]
          },
          "else": {
            "not": {
              "required": [
                "action"
              ]
            }
          }
        }
      ]
    },
    "AssistQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateRef",
