{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gift:design-schema:check-method-1",
  "title": "Negotiated qualified verification method request (design only)",
  "description": "Extends gift.check without changing types/cases branches. Formal, static, fuzz, sanitizer, property, coverage and other genuine verification remain selected by trusted method/obligation owners; the interface does not execute arbitrary method strings.",
  "$ref": "#/$defs/MethodCheck",
  "$defs": {
    "MethodCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateRef",
        "methodRef",
        "requestId"
      ],
      "properties": {
        "candidateRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "artifactRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "methodRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "claimRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "methodInputsRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "coverageRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "description": "A fixed qualified VerificationMethodSelection and accepted subject/claims, not a user-supplied executable command or a fabricated PASS. Host must bind actual safe runner, input, effect grant and evidence."
    }
  }
}
