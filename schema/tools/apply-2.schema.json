{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gift:design-schema:ai-tools-2-apply",
  "title": "gift.ai-tools/2 apply base params",
  "$comment": "Normative design structure only. Exact semantic references, qualification, authorization, filesystem identity and runtime effects require their declared consumers. Not a production implementation claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateRef",
    "mode",
    "targetRef",
    "base",
    "requestId"
  ],
  "properties": {
    "candidateRef": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "mode": {
      "enum": [
        "save-source",
        "write-output"
      ]
    },
    "targetRef": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "base": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "artifactRef": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "write-output"
          }
        }
      },
      "then": {
        "required": [
          "artifactRef"
        ]
      },
      "else": {
        "not": {
          "required": [
            "artifactRef"
          ]
        }
      }
    }
  ],
  "$defs": {
    "Json": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Json"
          },
          "minItems": 0
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        }
      ]
    }
  }
}
