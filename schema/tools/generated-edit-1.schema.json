{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gift:design-schema:generated-edit-1",
  "title": "Negotiated generated-edit draft",
  "$comment": "Normative design structure only. Exact semantic references, qualification, authorization, filesystem identity and runtime effects require their declared consumers. Not a production implementation claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "base",
    "artifactRef"
  ],
  "properties": {
    "kind": {
      "const": "generated-edit"
    },
    "base": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "artifactRef": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "old",
          "new"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "old": {
            "type": "string",
            "minLength": 1
          },
          "new": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "scope": {
      "enum": [
        "occurrence",
        "definition"
      ]
    },
    "targetFiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Exact complete text afterimages of existing members of the bound artifact G0. Unlisted members stay G0; empty string is an empty text afterimage, never deletion. New/deleted/moved/binary members require their own qualified source/asset route, not implicit permission here."
    }
  },
  "oneOf": [
    {
      "required": [
        "edits"
      ],
      "not": {
        "required": [
          "targetFiles"
        ]
      }
    },
    {
      "required": [
        "targetFiles"
      ],
      "not": {
        "required": [
          "edits"
        ]
      }
    }
  ]
}
