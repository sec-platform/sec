{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gift:design-schema:ai-tools-2-query",
  "title": "gift.ai-tools/2 query base params",
  "$comment": "Normative design structure only. Exact semantic references, qualification, authorization, filesystem identity and runtime effects require their declared consumers. Not a production implementation claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "at": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    },
    "find": {
      "$ref": "#/$defs/Json"
    },
    "view": {
      "enum": [
        "source",
        "contract",
        "diagnostics",
        "impact",
        "origin",
        "state"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}
    }
  },
  "$defs": {
    "Json": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Json"
          },
          "minItems": 0
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Json"
          }
        }
      ]
    }
  }
}
