    "r:Presentation": {
      "kind": "req:rule",
      "name": "Presentation",
      "body": {
        "strength": "require",
        "fields": {
          "search": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "SearchSurface"
              ]
            },
            "meaning": "结果模型"
          },
          "replace": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "ReplacementSurface"
              ]
            },
            "meaning": "替换计划"
          },
          "shell": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "WorkbenchSurface"
              ]
            },
            "meaning": "交互展示主体"
          },
          "navigation": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/search#ExactSourceMatch"
              ]
            },
            "meaning": "定位到准确结果来源，陈旧项显示失效"
          },
          "readonly": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/search#InspectableNotWritable"
              ]
            },
            "meaning": "只读项可看可导航但不可写"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
          "section": "search.Presentation",
          "sha256": "51c9b9fa0349a5432b091da71d09756c03c59997b24fe4328233b2a13fd91261",
          "scope": "完整相应章节，包括正常行为、失败、帧、进展、实现责任；不是仅按字段可解析便获得执行含义"
        },
