        },
        "implementation": "unbound"
      }
    },
    "r:Commands": {
      "kind": "req:rule",
      "name": "Commands",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "WorkbenchSurface"
              ]
            },
            "meaning": "命令入口表面"
          },
          "targets": {
            "required": true,
            "type": {
              "kind": "set",
              "element": {
                "kind": "subject",
                "subjectKinds": [
                  "Configuration",
                  "DebugSessionSet",
                  "EditorSurface",
                  "ExtensionSet",
                  "LanguageServiceSet",
                  "ReplacementSurface",
                  "SearchSurface",
                  "TaskSet",
                  "TerminalSet",
                  "TestSet",
                  "VersionIntegration",
                  "Workspace"
                ]
              }
            },
            "meaning": "公开可执行动作的语义主体集合"
          },
          "access": {
            "required": true,
            "type": {
              "kind": "set",
              "element": {
                "kind": "enum",
                "allowed": [
                  "gift/spec/experience#Menu",
                  "gift/spec/experience#Palette",
                  "gift/spec/experience#Keyboard"
                ]
              }
            },
            "meaning": "菜单、命令面板及键盘的等义入口"
          },
          "registry": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "gift/spec/experience#TypedCommandSchema"
              ]
            },
            "meaning": "从供给公开动作签名派生命令/参数/消息，不手抄三份处理器"
          },
          "enablement": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "gift/spec/experience#CurrentContext"
              ]
            },
            "meaning": "是否可用以当前主体能力/选择/权限决定"
          }
        },
