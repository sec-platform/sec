    "r:Layout": {
      "kind": "req:rule",
      "name": "Layout",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "WorkbenchSurface"
              ]
            },
            "meaning": "工作台交互表面"
          },
          "editor": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "EditorSurface"
              ]
            },
            "meaning": "主编辑区"
          },
          "workspace": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "Workspace"
              ]
            },
            "meaning": "文件树"
          },
          "search": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "SearchSurface"
              ]
            },
            "meaning": "搜索表面"
          },
          "diagnostics": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "DiagnosticSet"
              ]
            },
            "meaning": "问题表面"
          },
          "terminal": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "TerminalSet"
              ]
            },
            "meaning": "底部交互终端"
          },
          "panes": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "gift/spec/experience#WorkbenchLayout"
              ]
            },
            "meaning": "左侧文件/搜索，中央编辑，底部问题/终端，可隐藏、分屏和调整"
          },
          "visibility": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "gift/spec/experience#TaskContext"
              ]
            },
            "meaning": "显示状态按任务上下文而非改变实际需求"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
