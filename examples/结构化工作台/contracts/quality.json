    "r:Admission": {
      "kind": "req:rule",
      "name": "Admission",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "Workbench"
              ]
            },
            "meaning": "全部受管运行/查询"
          },
          "policy": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "gift/spec/quality#LimitsFromRuntimeProfile"
              ]
            },
            "meaning": "使用被绑定部署配置中的容量，不伪造未测性能数值"
          },
          "overload": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "gift/spec/quality#BoundedQueueOrReject"
              ]
            },
            "meaning": "内存/并发/待办有实际界限，超限暂停或拒绝"
          },
          "loss": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "gift/spec/quality#Explicit"
              ]
            },
            "meaning": "截断、丢弃、取消和未完成可观察"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
          "section": "quality.Admission",
          "sha256": "2a6fa276b26457cc30c07dc559270f9f1d718ea1f38a870e92661e4121460110",
          "scope": "完整相应章节，包括正常行为、失败、帧、进展、实现责任；不是仅按字段可解析便获得执行含义"
        },
        "implementation": "unbound"
      }
    },
    "r:Cost": {
      "kind": "req:rule",
      "name": "Cost",
      "body": {
        "strength": "prefer",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "Workbench"
              ]
            },
            "meaning": "选择的产品实例"
          },
          "metric": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "gift/spec/quality#ResidentMemory",
                "gift/spec/quality#InteractiveLatency"
              ]
            },
            "meaning": "驻留内存；第二条可以用InteractiveLatency"
          },
          "priority": {
            "required": true,
            "type": {
              "kind": "positive-integer"
            },
            "meaning": "正整数偏好次序，数值小者先；同次序为Pareto而非凭空加权"
          },
          "workload": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "gift/spec/quality#DeclaredWorkload"
              ]
            },
            "meaning": "比较按目标相同且明确的工作负载；未测为未知"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
