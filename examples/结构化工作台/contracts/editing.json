    "r:Documents": {
      "kind": "req:rule",
      "name": "Documents",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                {
                  "decl": {
                    "import": "subjects",
                    "export": "DocumentSpace"
                  }
                }
              ]
            },
            "meaning": "文档集合主体"
          },
          "resourceIdentity": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:FromWorkspace"
                }
              ]
            },
            "meaning": "与根/文件操作共用资源身份"
          },
          "coordinates": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:UnambiguousSourcePositions"
                }
              ]
            },
            "meaning": "位置绑定准确文本及可核对的坐标含义；字节、标量、字素及UTF-16等内部/外部单位由适配转换，不强制一种内部缓冲"
          },
          "encoding": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:PreserveOrExplicitConvert"
                }
              ]
            },
            "meaning": "保存保留可复现原编码，改变必须是明确转换"
          },
          "newlines": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:PreserveOriginal"
                }
              ]
            },
            "meaning": "保留原换行；显式规范化是独立行为"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
          "section": "editing.Documents",
          "scope": "完整相应章节，包括正常行为、失败、帧、进展、实现责任；不是仅按字段可解析便获得执行含义"
        },
        "implementation": "unbound"
      }
    },
