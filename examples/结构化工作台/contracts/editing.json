              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:ExplicitChanges"
                }
              ]
            },
            "meaning": "格式化等保存参与者产生的字节变化可见"
          },
          "conflicts": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:PreserveBoth"
                }
              ]
            },
            "meaning": "外部写冲突保留双方内容/依据"
          }
