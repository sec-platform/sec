            "meaning": "历史主体"
          },
          "documents": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                {
                  "decl": {
                    "import": "subjects",
                    "export": "DocumentSpace"
                  }
                }
              ]
            },
            "meaning": "同一模型集合"
          },
          "grouping": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:ByUserAction"
                }
              ]
            },
            "meaning": "一组实际用户动作形成一个逻辑撤销组"
          },
          "undo": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:IfCurrentCompatible"
                }
              ]
            },
            "meaning": "只有现场/历史允许才执行逆编辑"
          }
