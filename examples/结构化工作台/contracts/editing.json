          "documents": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                {
                  "decl": {
                    "import": "subjects",
                    "export": "DocumentSpace"
                  }
                }
              ]
            },
            "meaning": "实际被编辑的模型集合"
          },
          "selections": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:Multiple"
                }
              ]
            },
            "meaning": "多个选区与光标及确定合并/冲突规则"
          },
          "views": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:ManyViewsOneModel"
                }
              ]
            },
            "meaning": "多个视图绑定同一模型而不是各复制一份内容"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
