    "r:Roots": {
      "kind": "req:rule",
      "name": "Roots",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "Workspace"
              ]
            },
            "meaning": "根集合的主体身份"
          },
          "multiplicity": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/workspace#Many"
              ]
            },
            "meaning": "允许零个或多个根；未打开根不算失败"
          },
          "identity": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/workspace#ProviderIdentity"
              ]
            },
            "meaning": "按提供者的规范资源身份，显示路径不定义相等"
          },
          "nested": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/workspace#ExplicitMembership"
              ]
            },
            "meaning": "嵌套根的归属选择显式，不按扫描先后隐式抢占"
          }
        },
