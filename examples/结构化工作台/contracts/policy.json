    "r:Network": {
      "kind": "req:rule",
      "name": "Network",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                {
                  "decl": {
                    "import": "subjects",
                    "export": "EffectBoundary"
                  }
                }
              ]
            },
            "meaning": "产品根内全部网络作用，含生成依赖和扩展"
          },
          "policy": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:OriginAndPurposeGrant"
                }
              ]
            },
            "meaning": "按主体/来源/目的/时间授权"
          },
          "background": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:DeniedUnlessGranted"
                }
              ]
            },
            "meaning": "后台联网默认拒绝，用户可明示授予目的"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
          "section": "policy.Network",
          "scope": "完整相应章节，包括正常行为、失败、帧、进展、实现责任；不是仅按字段可解析便获得执行含义"
        },
        "implementation": "unbound"
      }
    },
    "r:Destruction": {
      "kind": "req:rule",
      "name": "Destruction",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                {
                  "decl": {
                    "import": "subjects",
                    "export": "EffectBoundary"
                  }
                }
              ]
            },
            "meaning": "破坏性/不可逆作用主体"
          },
          "policy": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:ScopeAndRevisionGrant"
                }
              ]
            },
            "meaning": "许可绑定实际对象范围和有效前置"
          },
          "retry": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:OnlyEffectiveIdempotencyOrFinality"
                }
              ]
            },
            "meaning": "仅有效同意图去重或旧尝试终结后确认无效果可重试"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
          "section": "policy.Destruction",
          "scope": "完整相应章节，包括正常行为、失败、帧、进展、实现责任；不是仅按字段可解析便获得执行含义"
        },
        "implementation": "unbound"
      }
    }
