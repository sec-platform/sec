    "r:Execution": {
      "kind": "req:rule",
      "name": "Execution",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                {
                  "decl": {
                    "import": "subjects",
                    "export": "ExtensionSet"
                  }
                }
              ]
            },
            "meaning": "扩展集合"
          },
          "effects": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                {
                  "decl": {
                    "import": "subjects",
                    "export": "EffectBoundary"
                  }
                }
              ]
            },
            "meaning": "所有外部作用的边界"
          },
          "modes": {
            "required": true,
            "type": {
              "kind": "set",
              "element": {
                "kind": "enum",
                "allowed": [
                  {
                    "definitionId": "v:DeclarativeContribution"
                  },
                  {
                    "definitionId": "v:IsolatedExecutable"
                  }
                ]
              }
            },
            "meaning": "允许声明贡献和隔离执行扩展"
          },
          "authority": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:DeclaredAndGranted"
                }
              ]
            },
            "meaning": "声明需求与取得许可分别检查"
          },
          "failure": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:ContainAndDisable"
                }
              ]
            },
            "meaning": "故障隔离并可禁用"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
          "section": "extension.Execution",
          "scope": "完整相应章节，包括正常行为、失败、帧、进展、实现责任；不是仅按字段可解析便获得执行含义"
        },
        "implementation": "unbound"
      }
    },
    "r:Compatibility": {
      "kind": "req:rule",
      "name": "Compatibility",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                {
                  "decl": {
                    "import": "subjects",
                    "export": "ExtensionSet"
                  }
                }
              ]
            },
            "meaning": "相同扩展集合"
          },
          "api": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:VersionedCapability"
                }
              ]
            },
            "meaning": "接口按语义能力版本匹配"
          },
          "installed": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:ExactContent"
                }
              ]
            },
            "meaning": "安装内容与声明及来源绑定"
          },
          "unknown": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                {
                  "definitionId": "v:RejectUnsupportedRequirement"
                }
              ]
            },
            "meaning": "未知必需能力拒绝启用"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
