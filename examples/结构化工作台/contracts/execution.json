        },
        "implementation": "unbound"
      }
    },
    "r:Terminal": {
      "kind": "req:rule",
      "name": "Terminal",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "TerminalSet"
              ]
            },
            "meaning": "交互终端主体"
          },
          "tasks": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "TaskSet"
              ]
            },
            "meaning": "实际进程集合"
          },
          "input": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#OrderedNoUnknownReplay"
              ]
            },
            "meaning": "输入排队、短写和未知消费范围分别处理"
          },
          "streams": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#SeparateWithGaps"
              ]
            },
            "meaning": "stdout/stderr各自顺序，截断显式"
          },
          "lifetime": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#ExplicitCloseAndReconcile"
              ]
            },
            "meaning": "EOF、signal、进程及子树退出分别结算"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
          "section": "execution.Terminal",
