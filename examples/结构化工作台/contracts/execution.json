    "r:Tasks": {
      "kind": "req:rule",
      "name": "Tasks",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "TaskSet"
              ]
            },
            "meaning": "构建/运行任务主体"
          },
          "workspace": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "Workspace"
              ]
            },
            "meaning": "任务输入"
          },
          "selection": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#DeclaredEntries"
              ]
            },
            "meaning": "发现或声明的准确入口"
          },
          "inputs": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#ArgumentVector"
              ]
            },
            "meaning": "参数向量，无隐式shell拼接"
          },
          "effect": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#RuntimeGrant"
              ]
            },
            "meaning": "实际启动许可"
          },
          "lifetime": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#OwnedScope"
              ]
            },
            "meaning": "启动、子任务、结果与退出有拥有者"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
