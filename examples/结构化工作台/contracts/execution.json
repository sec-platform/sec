            "meaning": "案例和结果主体"
          },
          "tasks": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "TaskSet"
              ]
            },
            "meaning": "真实运行"
          },
          "workspace": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "Workspace"
              ]
            },
            "meaning": "案例与工程来源"
          },
          "discovery": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#LazyCoverageExplicit"
              ]
            },
            "meaning": "懒发现与完整范围不同，执行发现需许可"
          },
          "input": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#ExactCandidate"
              ]
