        },
        "implementation": "unbound"
      }
    },
    "r:Debug": {
      "kind": "req:rule",
      "name": "Debug",
      "body": {
        "strength": "require",
        "fields": {
          "on": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "DebugSessionSet"
              ]
            },
            "meaning": "调试会话"
          },
          "tasks": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "TaskSet"
              ]
            },
            "meaning": "启动或附加目标"
          },
          "documents": {
            "required": true,
            "type": {
              "kind": "subject",
              "subjectKinds": [
                "DocumentSpace"
              ]
            },
            "meaning": "显示和来源对应"
          },
          "capability": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#Negotiated"
              ]
            },
            "meaning": "按真实驱动能力启用"
          },
          "source": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#LoadedArtifact"
              ]
            },
            "meaning": "来源跟随已加载制品，不是latest"
          },
          "handles": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#StopScoped"
              ]
            },
            "meaning": "栈和值句柄只对当前停点有效"
          },
          "controls": {
            "required": true,
            "type": {
              "kind": "enum",
              "allowed": [
                "sec/spec/execution#NoDuplicateUncertainCommand"
              ]
            },
            "meaning": "同一接受的控制在响应未知时不能重复作用；实际驱动可用串行未决槽实现，不把槽本身当产品要求"
          }
        },
        "semantics": {
          "source": "../../../docs/作者/需求规则与供给合同.md",
