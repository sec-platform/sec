  "semanticObligations": [
    {
      "case": "two non-Copy fields",
      "expected": "transfer each once; no Clone/Copy premise; no drop of the other field"
    },
    {
      "case": "duplicate field or binder",
      "expected": "reject even if JSON structure is valid"
    },
    {
      "case": "missing or extra field",
      "expected": "reject; exact complete coverage required"
    },
    {
      "case": "optional, mutable, open or invisible field",
      "expected": "reject this binding form; preserve original specialized operations"
    },
    {
      "case": "whole-record Drop, active borrow or fixed-address constraint",
      "expected": "reject unless original ownership owner establishes legal complete move"
    },
    {
      "case": "initializer shadowing",
      "expected": "resolve initializer in old scope; publish new bindings only to continuation"
    },
    {
      "case": "abnormal exit after ownership transfer",
      "expected": "each remaining obligation is settled once by its actual owner; implicit effects retained"
    }
  ]
}
