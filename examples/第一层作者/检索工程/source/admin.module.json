{
  "schema": "gift.author-module/design-converged",
  "moduleId": "module:retrieval-admin",
  "imports": {
    "business": {
      "workspace": "module:retrieval-business-input"
    },
    "sourceModel": {
      "workspace": "module:source-model-subjects-v1"
    },
    "input": {
      "workspace": "module:retrieval-input-subjects"
    },
    "engineering": {
      "workspace": "module:retrieval-engineering"
    }
  },
  "definitions": {
    "AdminUI": {
      "product:component": {
        "provides": [
          "business:AdminPort"
        ],
        "requires": [
          "business:ServicePort"
        ],
        "requirements": [
          {
            "ref": "engineering:AdminRequirements",
            "roleBindings": {
              "ui": {
                "source": "context",
                "role": "self"
              },
              "business": {
                "source": "context",
                "role": "business"
              }
            }
          }
        ],
        "contextRoles": {
          "business": {
            "typeRef": "input:BusinessContract",
            "cardinality": "one"
          },
          "self": {
            "typeRef": "sourceModel:Component",
            "cardinality": "one"
          }
        }
      }
    }
  },
  "exports": [
    "AdminUI"
  ]
}
