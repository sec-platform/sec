{
  "scope": "Finite design formation vectors. Ref targets and phase qualification are not established by Schema. Not a runnable engineering module.",
  "cases": [
    {
      "name": "constructor binds raw input and one successful typed state",
      "schema": "urn:gift:design-schema:first-layer-component-contracts#/$defs/ComponentBody",
      "expectedStructure": true,
      "value": {
        "providedPorts": {"snapshot": "local:Snapshot", "replace": "local:Replace"},
        "requiredPorts": {}, "requirements": [],
        "state": {"rows": {"type": {"tag": "nominal", "ref": "local:Rows"}}},
        "constructor": {
          "parameters": [{"name": "initialRows", "type": {"tag": "nominal", "ref": "local:TargetPassiveValue"}, "mode": "in"}],
          "errors": {"tag": "nominal", "ref": "local:CreateError"}, "effects": [],
          "requirements": [{"ref": "local:StoreCreated", "callBinding": {"at": "success", "roles": {
            "raw": {"source": "parameter", "name": "initialRows"},
            "rows": {"source": "state", "when": "after", "cell": "rows"}
          }}}]
        }
      },
      "semanticBoundary": "The fragment needs the named local type/interface/relation definitions, all normal/error/progress obligations and a common realizable witness. No reference or implementation qualification is claimed."
    },
    {
      "name": "same interface has two distinct provided occurrences",
      "schema": "urn:gift:design-schema:first-layer-component-contracts#/$defs/ComponentBody",
      "expectedStructure": true,
      "value": {
        "providedPorts": {"mainRead": "local:Read", "previewRead": "local:Read"},
        "requiredPorts": {"source": "local:Snapshot"}, "requirements": [],
        "constructor": {"parameters": [], "errors": {"tag": "scalar", "name": "never"}, "effects": [], "requirements": []},
        "composition": {"components": [
          {"instance": "main", "componentRef": "local:ThresholdView", "argumentBindings": {"initialThreshold": {"source": "parameter", "parameter": "mainInitial"}}},
          {"instance": "preview", "componentRef": "local:ThresholdView", "argumentBindings": {"initialThreshold": {"source": "parameter", "parameter": "previewInitial"}}}
        ], "connections": [
          {"source": {"instancePath": ["main"], "port": "read"}, "target": {"boundaryPort": {"direction": "provides", "name": "mainRead"}}},
          {"source": {"instancePath": ["preview"], "port": "read"}, "target": {"boundaryPort": {"direction": "provides", "name": "previewRead"}}},
          {"source": {"boundaryPort": {"direction": "requires", "name": "source"}}, "target": {"instancePath": ["main"], "port": "source"}},
          {"source": {"boundaryPort": {"direction": "requires", "name": "source"}}, "target": {"instancePath": ["preview"], "port": "source"}}
        ]}
      },
      "semanticBoundary": "Formation fragment only: the complete TwinViews must declare mainInitial/previewInitial and forward both Set ports as specified by the complete engineering design. Empty requirements do not prove total construction or borrow compatibility."
    },
    {
      "name": "runtime constructor argument is separate from template actual",
      "schema": "urn:gift:design-schema:universal-author-module-2-converged-base#/$defs/ComponentUse",
      "expectedStructure": true,
      "value": {"instance": "store", "componentRef": "local:Store", "constructorArguments": {"initialRows": {"op": "var", "name": "initialRows"}}}
    },
    {
      "name": "static parameter forwarding has a distinct source tag",
      "schema": "urn:gift:design-schema:universal-author-module-2-converged-base#/$defs/ComponentUse",
      "expectedStructure": true,
      "value": {"instance": "main", "componentRef": "local:ThresholdView", "argumentBindings": {"initialThreshold": {"source": "parameter", "parameter": "mainInitial"}}}
    },
    {
      "name": "runtime expression remains forbidden in static argumentBindings",
      "schema": "urn:gift:design-schema:universal-author-module-2-converged-base#/$defs/ComponentUse",
      "expectedStructure": false,
      "value": {"instance": "store", "componentRef": "local:Store", "argumentBindings": {"initialRows": {"op": "var", "name": "initialRows"}}}
