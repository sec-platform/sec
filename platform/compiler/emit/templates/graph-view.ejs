    term.scrollTop = term.scrollHeight;
  }

  async function triggerHotCompile() {
    if (mutationsList.length === 0) {
      alert(currentLang === 'zh' ? '当前没有待保存的图形修改！' : 'No graph mutations to compile!');
      return;
    }

    const overlay = document.getElementById('stitching-overlay');
    const term = document.getElementById('terminal-screen');
    const overlayText = document.getElementById('overlay-text');
    const errorActions = document.getElementById('overlay-error-actions');

    term.innerHTML = '';
    errorActions.style.display = 'none';
    overlayText.textContent = 'Saving Mutations & Initiating Hot Compile...';
    overlay.classList.add('active');

    appendTerminalLine('POST /api/mutations - Saving active mutations...', 'info');

    try {
      const res = await fetch('/api/mutations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          formatVersion: "1",
          mutations: mutationsList
        })
      });
      if (!res.ok) {
        throw new Error('Failed to save mutations to server.');
      }
      appendTerminalLine('SUCCESS: Mutations written to source/views/mutations/graph-action.json', 'success');
    } catch(err) {
      appendTerminalLine(`[ERROR] ${err.message || err}`, 'error');
      overlayText.textContent = 'Mutation Sync Failed';
      errorActions.style.display = 'flex';
      return;
    }

    appendTerminalLine('POST /api/compile - Connecting to compiler engine progress stream...', 'info');
    overlayText.textContent = 'Compiling & Stitching Project...';

    try {
      const response = await fetch('/api/compile', { method: 'POST' });
      if (!response.ok) {
        throw new Error('Compile initialization endpoint failed.');
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const dataStr = line.slice(6);
            if (dataStr.startsWith('[ERROR]')) {
              appendTerminalLine(dataStr, 'error');
            } else if (dataStr.includes('successfully') || dataStr.includes('finished')) {
              appendTerminalLine(dataStr, 'success');
            } else {
              appendTerminalLine(dataStr, 'info');
            }
          } else if (line.includes('event: success')) {
            appendTerminalLine('SUCCESS: Redirection graph refreshed, reloading viewport in 1s...', 'success');
            overlayText.textContent = 'Compile Success!';
            setTimeout(() => {
              location.reload();
            }, 1000);
          } else if (line.includes('event: failure')) {
            appendTerminalLine('ERROR: Recompilation crashed. Please inspect logs above.', 'error');
            overlayText.textContent = 'Compile Failed';
            errorActions.style.display = 'flex';
          }
        }
      }
    } catch(err) {
      appendTerminalLine(`[ERROR] ${err.message || err}`, 'error');
      overlayText.textContent = 'Compile Failed';
      errorActions.style.display = 'flex';
    }
  }

  function retriggerCompile() {
    triggerHotCompile();
  }

  document.getElementById('recompile-btn').addEventListener('click', triggerHotCompile);
  document.getElementById('lang-btn').addEventListener('click', toggleLanguage);

  // 绑定全局键盘快捷键事件 (Delete/Backspace 删除, Ctrl+Z 撤销, Ctrl+Y 重做)
  document.addEventListener('keydown', function(e) {
    if (e.ctrlKey && e.key.toLowerCase() === 'z') {
      e.preventDefault();
      triggerUndo();
    } else if (e.ctrlKey && e.key.toLowerCase() === 'y') {
      e.preventDefault();
      triggerRedo();
    } else if (e.key === 'Delete' || e.key === 'Backspace') {
      if (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'SELECT') {
        handleKeyboardDelete();
      }
    }
  });

  // === Spec Builder V2.1 Immersive UI Interactive Controls ===
  
  // 1. 折叠左侧组件侧栏 (桥接兼容已有的测试/折叠动作)
  function toggleSidebar() {
    toggleCatalogPopover();
  }

  // 控制 Catalog Popover 的展开与关闭
  let isCatalogOpen = false;
  function toggleCatalogPopover() {
    const popover = document.getElementById('catalog-popover');
    if (!popover) return;
    isCatalogOpen = !isCatalogOpen;
    if (isCatalogOpen) {
      popover.style.display = 'flex';
      setTimeout(() => popover.classList.add('open'), 10);
      const icon = document.getElementById('dock-btn-catalog');
      if (icon) icon.classList.add('active');
    } else {
      popover.classList.remove('open');
      const icon = document.getElementById('dock-btn-catalog');
      if (icon) icon.classList.remove('active');
      setTimeout(() => {
        if (!isCatalogOpen) popover.style.display = 'none';
      }, 200);
    }
  }

  // 2. 展开/缩回底部多功能控制台（桥接兼容新悬浮 HUD 面板）
  let isBottomConsoleOpen = false;
  function toggleBottomConsole() {
    const panel = document.getElementById('bottom-console-panel');
    if (!panel) return;
    
    isBottomConsoleOpen = !isBottomConsoleOpen;
    if (isBottomConsoleOpen) {
      panel.style.display = 'flex';
      setTimeout(() => panel.classList.add('open'), 10);
    } else {
      panel.classList.remove('open');
      setTimeout(() => {
        if (!isBottomConsoleOpen) panel.style.display = 'none';
      }, 200);
    }
  }

  function toggleDiagnosticPopover() {
    toggleBottomConsole();
  }

  // 3. 在底部控制台切换不同的 Tab
  function selectConsoleTab(tabId) {
    // 切换 tabs 激活状态 (同时激活 tab-xxx)
    document.querySelectorAll('.console-tab').forEach(tab => {
      tab.classList.remove('active');
    });
    const activeTabEl = document.getElementById(`tab-${tabId}`);
    if (activeTabEl) activeTabEl.classList.add('active');
    
    // 切换内容区域可见性
    const contentIds = ['coverage', 'override', 'summary'];
    contentIds.forEach(id => {
      const container = document.getElementById(`console-content-${id}`);
      if (container) {
        container.style.display = (id === tabId) ? 'block' : 'none';
      }
    });
    
    // 确保底部面板自动打开
    if (!isBottomConsoleOpen) {
      isBottomConsoleOpen = false; // 重置状态
      toggleBottomConsole(); // 触发打开
    }
  }

  // 兼容支持 selectHudTab 的旧别名
  function selectHudTab(tabId) {
    selectConsoleTab(tabId);
  }

  // Initialize page translations and network layout with dynamic Blocks catalog scanning first
  applyTranslations();
  loadBlocksCatalog().then(() => {
    renderTopology();
  });
</script>
