<!-- Language Translation Toggle -->
<div class="canvas-header">
  <h1 data-key="title">拓扑与可操作设计画布 (Topology SPEC Builder)</h1>
  <button id="lang-btn" class="lang-toggle-btn">English</button>
</div>

<section class="card">
  <p data-key="desc">这是一个展示服务、插槽与文件依赖拓扑的交互式画布。支持节点拖拽、连线编辑和导出 Mutation 并在本地重新 Stitch 编译。</p>
  
  <!-- Interactive Visual SPEC Builder Canvas -->
  <div id="network-canvas" class="canvas-container"></div>
  
  <!-- Graphical Stitching Operator Controls -->
  <div class="operator-section">
    <div class="op-card">
      <div class="op-title" data-key="opTitle">图形组装装配器 (Stitching Operator)</div>
      
      <!-- Action 1: Add Block -->
      <div class="form-group" style="border-bottom: 1px solid #eee; padding-bottom: 12px;">
        <label data-key="addBlockLabel">在画布中添加新 Block 依赖 (Add Capability Block)</label>
        <div style="display: flex; gap: 8px; margin-top: 6px;">
          <select id="new-block-select" class="form-select">
            <option value="tenant/basic-workspace">tenant/basic-workspace (0.2.0)</option>
            <option value="comment/basic">comment/basic (0.1.0)</option>
            <option value="agent/executor">agent/executor (0.1.0)</option>
            <option value="file/upload">file/upload (0.1.0)</option>
            <option value="auth/basic-session">auth/basic-session (0.1.0)</option>
          </select>
          <button id="add-block-btn" class="form-btn" style="width: auto;" data-key="addBtn">添加 (Add)</button>
        </div>
      </div>

      <!-- Action 2: Connect Pin -->
      <div class="form-group">
        <label data-key="bindSlotLabel">建立插槽管脚连接 (Connect & Bind Slot)</label>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 6px;">
          <div>
            <label style="font-size: 11px;" data-key="slotIdLabel">Slot ID</label>
            <input id="slot-id-input" class="form-input" placeholder="new_slot_id" value="new_custom_slot" />
          </div>
          <div>
            <label style="font-size: 11px;" data-key="blockIdLabel">Target Block</label>
            <select id="slot-target-select" class="form-select">
              <option value="ticket/basic">ticket/basic</option>
              <option value="tenant/basic-workspace">tenant/basic-workspace</option>
              <option value="auth/basic-session">auth/basic-session</option>
            </select>
          </div>
        </div>
        <button id="bind-slot-btn" class="form-btn" style="margin-top: 10px;" data-key="bindBtn">建立连线并绑定 (Bind)</button>
      </div>
    </div>

    <!-- Exporter: Mutations JSON -->
    <div class="op-card" style="display: flex; flex-direction: column;">
      <div class="op-title" data-key="exporterTitle">Mutations 实时生成器 (Mutations Exporter)</div>
      <textarea id="exporter-textarea" class="exporter-textarea" readonly></textarea>
      <div class="exporter-actions">
        <button id="copy-json-btn" class="form-btn" data-key="copyBtn">复制 Mutations JSON</button>
        <button id="reset-op-btn" class="form-btn" style="background:#8c342f;" data-key="resetBtn">重置操作</button>
      </div>
      <p style="font-size: 11px; color:#666; margin-top:8px;" data-key="applyHint">
        提示：将生成的 JSON 保存到 source/views/mutations/drag.json 中，并在命令行运行 "bun run platform -- workbench mutations apply" 即可完整应用于项目编译。
      </p>
    </div>
  </div>
</section>

<!-- Traditional Statistics and Information Card -->
<section class="card">
  <h2 data-key="coverageMatrixTitle">Graph Coverage Matrix</h2>
  <%- dataTable(['Information','Source','Coverage','Count'], coverageRows, 4, 'No graph coverage.') %>

  <h3 data-key="coverageChartsTitle">Coverage Dashboard Charts</h3>
  <div class="coverage-chart-container">
    <div class="coverage-card">
      <div class="coverage-title" data-key="covTitleBlocks">Blocks Coverage</div>
      <div class="coverage-value" style="color: #81c784;"><%= covSummary ? covSummary.coveredBlockCount + ' / ' + covSummary.blockCount : '0 / 0' %></div>
      <div class="progress-bg">
        <div class="progress-fill" style="width: <%= blockPercent %>%; background: linear-gradient(90deg, #66bb6a, #81c784);"></div>
      </div>
      <div class="progress-label">
        <span data-key="covRatioLabel">Coverage Ratio</span>
        <span><%= blockPercent %>%</span>
      </div>
    </div>

    <div class="coverage-card">
      <div class="coverage-title" data-key="covTitleSlots">Slots Coverage</div>
      <div class="coverage-value" style="color: #4fc3f7;"><%= covSummary ? covSummary.coveredSlotCount + ' / ' + covSummary.slotCount : '0 / 0' %></div>
      <div class="progress-bg">
        <div class="progress-fill" style="width: <%= slotPercent %>%; background: linear-gradient(90deg, #29b6f6, #4fc3f7);"></div>
      </div>
      <div class="progress-label">
        <span data-key="covRatioLabel">Coverage Ratio</span>
        <span><%= slotPercent %>%</span>
      </div>
    </div>

    <div class="coverage-card">
      <div class="coverage-title" data-key="covTitleAcceptance">Acceptance Tests</div>
      <div class="coverage-value" style="color: #ba68c8;"><%= nodeTypeCounts.get('acceptance') ?? 0 %></div>
      <div class="progress-bg">
        <div class="progress-fill" style="width: 100%; background: #ab47bc;"></div>
      </div>
      <div class="progress-label">
        <span data-key="covAcceptanceLabel">Acceptance Nodes</span>
        <span data-key="covActiveLabel">Active</span>
      </div>
    </div>

    <div class="coverage-card">
      <div class="coverage-title" data-key="covTitlePolicy">Policy Rules</div>
      <div class="coverage-value" style="color: #ffb74d;"><%= nodeTypeCounts.get('policy') ?? 0 %></div>
      <div class="progress-bg">
        <div class="progress-fill" style="width: 100%; background: #ffa726;"></div>
      </div>
      <div class="progress-label">
        <span data-key="covPolicyLabel">Policy Constraints</span>
        <span data-key="covEnforcedLabel">Enforced</span>
      </div>
    </div>
  </div>
</section>

<!-- Traditional Node/Edge tables for deep verification -->
<section class="card">
  <h2 data-key="manualOverrideTitle">Manual Override Registry</h2>
  <p data-key="manualOverrideDesc">Tracked artifacts and nodes that have been manually overridden by developers.</p>
  <%- dataTable(['Override Target', 'Origin Type', 'Source Block', 'Status'], manualOverrideRows, 4, 'No manual overrides detected in workspace.') %>
</section>

<section class="card">
  <h2 data-key="summaryTitle">Node & Edge Summary</h2>
  <%- dataTable(['Type','Count'], nodeTypeRows, 2, 'No graph nodes.') %>
  <div style="margin-top: 15px;"></div>
  <%- dataTable(['Type','Count'], edgeTypeRows, 2, 'No graph edges.') %>
</section>

<!-- Vis.js Dynamic Loader and Bilingual translation mechanism -->
<script type="text/javascript">
  const rawGraph = <%- JSON.stringify(graph) %>;

  const translationDict = {
    zh: {
      title: "系统拓扑依赖设计画布 (Topology SPEC Builder)",
      desc: "这是一个展示服务、插槽与文件依赖拓扑的交互式画布。支持节点拖拽、连线编辑和导出 Mutation 并在本地重新 Stitch 编译。",
      opTitle: "图形组装装配器 (Stitching Operator)",
      addBlockLabel: "在画布中添加新 Block 依赖 (Add Capability Block)",
      addBtn: "添加新 Block",
      bindSlotLabel: "建立插槽管脚连接 (Connect & Bind Slot)",
      slotIdLabel: "插槽 ID",
      blockIdLabel: "连接的目标 Block",
      bindBtn: "建立连线并绑定",
      exporterTitle: "Mutations 实时生成器 (Mutations Exporter)",
      copyBtn: "复制 Mutations JSON",
      resetBtn: "重置操作",
      applyHint: "提示：将生成的 JSON 保存到 source/views/mutations/drag.json 中，并在命令行运行 \"bun run platform -- workbench mutations apply\" 即可完整应用于项目编译。",
      coverageMatrixTitle: "架构覆盖率矩阵 (Graph Coverage Matrix)",
      coverageChartsTitle: "覆盖度仪表盘 (Coverage Dashboard)",
      covTitleBlocks: "能力块覆盖率",
      covTitleSlots: "插槽覆盖率",
      covTitleAcceptance: "验收测试用例",
      covTitlePolicy: "安全策略规则",
      covRatioLabel: "覆盖比例",
      covAcceptanceLabel: "验收节点",
      covActiveLabel: "活跃",
      covPolicyLabel: "安全约束",
      covEnforcedLabel: "强制执行",
      manualOverrideTitle: "人工接管审计 (Manual Override Registry)",
      manualOverrideDesc: "被开发人员物理手动覆盖的产物或配置文件。",
      summaryTitle: "拓扑节点与边摘要 (Summary)",
      
      // 节点类型翻译
      app: "主系统",
      block: "能力块",
      capability: "公共能力",
      pin: "缝合引脚",
      slot: "Slot 插槽",
      file: "生成产物",
      acceptance: "验收测试",
      policy: "安全策略"
    },
    en: {
      title: "Interactive SPEC Builder Canvas",
      desc: "An interactive topology canvas displaying services, slots, and file attributions. Supports drag-and-drop actions and mutations exporting.",
      opTitle: "Stitching Operator",
      addBlockLabel: "Add Capability Block to Canvas",
      addBtn: "Add Block",
      bindSlotLabel: "Connect & Bind Slot Pin",
      slotIdLabel: "Slot ID",
      blockIdLabel: "Target Block Connection",
      bindBtn: "Bind & Connect",
      exporterTitle: "Mutations Exporter",
      copyBtn: "Copy Mutations JSON",
      resetBtn: "Reset Operations",
      applyHint: "Tip: Save this generated JSON into source/views/mutations/drag.json, then run \"bun run platform -- workbench mutations apply\" to stitch and rebuild the codebase.",
      coverageMatrixTitle: "Graph Coverage Matrix",
      coverageChartsTitle: "Coverage Dashboard Charts",
      covTitleBlocks: "Blocks Coverage",
      covTitleSlots: "Slots Coverage",
      covTitleAcceptance: "Acceptance Tests",
      covTitlePolicy: "Policy Rules",
      covRatioLabel: "Coverage Ratio",
      covAcceptanceLabel: "Acceptance Nodes",
      covActiveLabel: "Active",
      covPolicyLabel: "Policy Constraints",
      covEnforcedLabel: "Enforced",
      manualOverrideTitle: "Manual Override Registry",
      manualOverrideDesc: "Tracked artifacts and nodes that have been manually overridden by developers.",
      summaryTitle: "Node & Edge Summary",
      
      app: "Application",
      block: "Block",
      capability: "Capability",
      pin: "Pin",
      slot: "Slot",
      file: "Generated File",
      acceptance: "Acceptance",
      policy: "Policy"
    }
  };

  let currentLang = 'en'; // 默认英文
  let mutationsList = [];

  function toggleLanguage() {
    currentLang = currentLang === 'en' ? 'zh' : 'en';
    document.getElementById('lang-btn').textContent = currentLang === 'en' ? '中文' : 'English';
    applyTranslations();
    renderTopology();
  }

  function applyTranslations() {
    const langObj = translationDict[currentLang];
    document.querySelectorAll('[data-key]').forEach(el => {
      const key = el.getAttribute('data-key');
      if (langObj[key]) {
        el.textContent = langObj[key];
      }
    });
  }

  // Vis.js Graph colors mapping
  const groupStyles = {
    app: { color: { background: '#ef5350', border: '#b71c1c' }, shape: 'dot' },
    block: { color: { background: '#66bb6a', border: '#1b5e20' }, shape: 'diamond' },
    capability: { color: { background: '#42a5f5', border: '#0d47a1' }, shape: 'ellipse' },
    pin: { color: { background: '#ffca28', border: '#f57f17' }, shape: 'triangle' },
    slot: { color: { background: '#ab47bc', border: '#4a148c' }, shape: 'star' },
    file: { color: { background: '#78909c', border: '#263238' }, shape: 'box' },
    acceptance: { color: { background: '#ec407a', border: '#880e4f' }, shape: 'hexagon' },
    policy: { color: { background: '#ff9800', border: '#e65100' }, shape: 'database' }
  };

  let network = null;
  let visNodes = null;
  let visEdges = null;

  function renderTopology() {
    const nodesArray = rawGraph.nodes.map(n => {
      const style = groupStyles[n.type] || { color: { background: '#9e9e9e', border: '#616161' }, shape: 'dot' };
      const prefix = translationDict[currentLang][n.type] || n.type;
      return {
        id: n.id,
        label: `${prefix}:\n${n.label}`,
        title: `Type: ${n.type}\nID: ${n.id}`,
        ...style,
        font: { color: '#ffffff', size: 12, face: 'monospace' }
      };
    });

    const edgesArray = rawGraph.edges.map(e => ({
      from: e.from,
      to: e.to,
      label: e.type,
      arrows: 'to',
      font: { color: '#a4f4db', size: 10, strokeWidth: 0, face: 'monospace' },
      color: { color: '#2b7561', highlight: '#4ef4c2' }
    }));

    visNodes = new vis.DataSet(nodesArray);
    visEdges = new vis.DataSet(edgesArray);

    const container = document.getElementById('network-canvas');
    const data = { nodes: visNodes, edges: visEdges };
    const options = {
      physics: {
        forceAtlas2Based: {
          gravitationalConstant: -26,
          centralGravity: 0.005,
          springLength: 130,
          springConstant: 0.18
        },
        maxVelocity: 146,
        solver: 'forceAtlas2Based',
        timestep: 0.35,
        stabilization: { iterations: 150 }
      },
      interaction: {
        hover: true,
        tooltipDelay: 100
      }
    };

    network = new vis.Network(container, data, options);
  }

  function updateMutationsExporter() {
    const report = {
      formatVersion: "1",
      mutations: mutationsList
    };
    document.getElementById('exporter-textarea').value = JSON.stringify(report, null, 2);
  }

  // Bind graphical events for simulation
  document.getElementById('add-block-btn').addEventListener('click', () => {
    const selectEl = document.getElementById('new-block-select');
    const blockId = selectEl.value;
    const version = "0.1.0";
    const mutationId = `mut-block-${Date.now()}`;

    // Add operation
    mutationsList.push({
      id: mutationId,
      kind: 'add-block',
      blockId: blockId,
      version: version
    });

    // Dynamically insert block into network graph
    if (visNodes) {
      visNodes.add({
        id: `block:${blockId}`,
        label: `${translationDict[currentLang].block}:\n${blockId}`,
        ...groupStyles.block,
        font: { color: '#ffffff', size: 12, face: 'monospace' }
      });
    }

    updateMutationsExporter();
  });

  document.getElementById('bind-slot-btn').addEventListener('click', () => {
    const slotId = document.getElementById('slot-id-input').value.trim();
    const blockId = document.getElementById('slot-target-select').value;
    const mutationId = `mut-slot-${Date.now()}`;

    if (!slotId) return;

    // Add binding
    mutationsList.push({
      id: mutationId,
      kind: 'bind-slot',
      slotId: slotId,
      block: blockId,
      slotKind: 'adapter',
      target: `custom/${slotId}.ts`,
      sourcePath: `source/code/slots/${slotId}.ts`,
      symbol: `handle${slotId.charAt(0).toUpperCase() + slotId.slice(1)}`
    });

    // Dynamically insert slot and connect edge to block node
    if (visNodes && visEdges) {
      const slotNodeId = `slot:${slotId}`;
      if (!visNodes.get(slotNodeId)) {
        visNodes.add({
          id: slotNodeId,
          label: `${translationDict[currentLang].slot}:\n${slotId}`,
          ...groupStyles.slot,
          font: { color: '#ffffff', size: 12, face: 'monospace' }
        });
      }
      visEdges.add({
        from: `block:${blockId}`,
        to: slotNodeId,
        label: 'connects_to',
        arrows: 'to',
        color: { color: '#ab47bc' }
      });
    }

    updateMutationsExporter();
  });

  document.getElementById('reset-op-btn').addEventListener('click', () => {
    mutationsList = [];
    updateMutationsExporter();
    renderTopology(); // Re-render to restore original state
  });

  document.getElementById('copy-json-btn').addEventListener('click', () => {
    const textarea = document.getElementById('exporter-textarea');
    textarea.select();
    document.execCommand('copy');
    alert(currentLang === 'zh' ? 'Mutations JSON 已经复制到剪贴板！' : 'Mutations JSON copied to clipboard!');
  });

  document.getElementById('lang-btn').addEventListener('click', toggleLanguage);

  // Initialize
  applyTranslations();
  renderTopology();
  updateMutationsExporter();
</script>
