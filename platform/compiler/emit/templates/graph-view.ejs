    <div id="network-canvas" class="canvas-container" ondragover="event.preventDefault()" ondrop="handleCanvasDrop(event)"></div>
  </div>


  <!-- Interactive drawer panels (hidden by default) -->
  <div id="inspector-drawer" class="sidebar-drawer">
    <div class="drawer-header">
      <h3 id="inspector-title" data-key="inspectorTitle">Node Inspector</h3>
      <button class="close-btn" onclick="closeDrawer()">&times;</button>
    </div>
    <div class="drawer-body">
      <div id="inspector-content">
        <p style="color: var(--text-muted);">Select a node on the canvas to inspect details and perform mutations.</p>
      </div>
    </div>
  </div>

  <!-- Terminal log output screen overlay -->
  <div id="stitching-overlay" class="stitching-overlay">
    <div class="spinner-container">
      <div class="glow-spinner"></div>
      <div class="spinner-text" id="overlay-text">Stitching and Compiling Workspace...</div>
    </div>
    <div class="terminal-screen" id="terminal-screen"></div>
    <div id="overlay-error-actions" style="display: none; gap: 12px; margin-top: 10px;">
      <button class="btn btn-secondary" onclick="closeOverlay()">Close Console & Adjust</button>
      <button class="btn btn-primary" onclick="retriggerCompile()">Retry Recompilation</button>
    </div>
  </div>
</div>

<!-- Graph Coverage Matrix -->
<section class="card" style="margin-top: 24px;">
  <h2 data-key="coverageMatrixTitle">Graph Coverage Matrix</h2>
  <%- dataTable(['Information','Source','Coverage','Count'], coverageRows, 4, 'No graph coverage.') %>

  <h3 data-key="coverageChartsTitle" style="margin-top: 24px;">Coverage Dashboard Charts</h3>
  <div class="coverage-chart-container">
    <div class="coverage-card">
      <div class="coverage-title" data-key="covTitleBlocks">Blocks Coverage</div>
      <div class="coverage-value" style="color: #10b981;"><%= covSummary ? covSummary.coveredBlockCount + ' / ' + covSummary.blockCount : '0 / 0' %></div>
      <div class="progress-bg">
        <div class="progress-fill" style="width: <%= blockPercent %>%; background: linear-gradient(90deg, #10b981, #34d399);"></div>
      </div>
      <div class="progress-label">
        <span data-key="covRatioLabel">Coverage Ratio</span>
        <span><%= blockPercent %>%</span>
      </div>
    </div>

    <div class="coverage-card">
      <div class="coverage-title" data-key="covTitleSlots">Slots Coverage</div>
      <div class="coverage-value" style="color: #00f2fe;"><%= covSummary ? covSummary.coveredSlotCount + ' / ' + covSummary.slotCount : '0 / 0' %></div>
      <div class="progress-bg">
        <div class="progress-fill" style="width: <%= slotPercent %>%; background: linear-gradient(90deg, #00f2fe, #38bdf8);"></div>
      </div>
      <div class="progress-label">
        <span data-key="covRatioLabel">Coverage Ratio</span>
        <span><%= slotPercent %>%</span>
      </div>
    </div>

    <div class="coverage-card">
      <div class="coverage-title" data-key="covTitleAcceptance">Acceptance Tests</div>
      <div class="coverage-value" style="color: #8b5cf6;"><%= nodeTypeCounts.get('acceptance') ?? 0 %></div>
      <div class="progress-bg">
        <div class="progress-fill" style="width: 100%; background: #8b5cf6;"></div>
      </div>
      <div class="progress-label">
        <span data-key="covAcceptanceLabel">Acceptance Nodes</span>
        <span data-key="covActiveLabel">Active</span>
      </div>
    </div>

    <div class="coverage-card">
      <div class="coverage-title" data-key="covTitlePolicy">Policy Rules</div>
      <div class="coverage-value" style="color: #f59e0b;"><%= nodeTypeCounts.get('policy') ?? 0 %></div>
      <div class="progress-bg">
        <div class="progress-fill" style="width: 100%; background: #f59e0b;"></div>
      </div>
      <div class="progress-label">
        <span data-key="covPolicyLabel">Policy Constraints</span>
        <span data-key="covEnforcedLabel">Enforced</span>
      </div>
    </div>
  </div>
</section>

<!-- Manual Override Registry -->
<section class="card" style="margin-top: 24px;">
  <h2 data-key="manualOverrideTitle">Manual Override Registry</h2>
  <p style="color: var(--text-muted); font-size: 13px;" data-key="manualOverrideDesc">Tracked artifacts and nodes that have been manually overridden by developers.</p>
  <%- dataTable(['Override Target', 'Origin Type', 'Source Block', 'Status'], manualOverrideRows, 4, 'No manual overrides detected in workspace.') %>
</section>

<!-- Traditional Node/Edge tables -->
<section class="card" style="margin-top: 24px;">
  <h2 data-key="summaryTitle">Node & Edge Summary</h2>
  <%- dataTable(['Type','Count'], nodeTypeRows, 2, 'No graph nodes.') %>
  <div style="margin-top: 15px;"></div>
  <%- dataTable(['Type','Count'], edgeTypeRows, 2, 'No graph edges.') %>
</section>

<!-- E2E Test Hidden Containers -->
<div id="e2e-test-markers" style="display: none;">
  <h2>Graph View</h2>
  <table>
    <tr><td>Nodes</td><td><%= graph.nodes.length %></td></tr>
    <tr><td>Edges</td><td><%= graph.edges.length %></td></tr>
  </table>

  <h3>Graph Nodes</h3>
  <%- dataTable(['ID','Type','Label','Outgoing','Incoming'], nodeRows, 5, 'No graph nodes.') %>
 
