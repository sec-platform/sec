  <%- dataTable(['From','Type','To'], edgeRows, 3, 'No graph edges.') %>
 
  <h3>Node Type Summary</h3>
  <%- dataTable(['Type','Count'], nodeTypeRows, 2, 'No graph nodes.') %>
 
  <h3>Edge Type Summary</h3>
  <%- dataTable(['Type','Count'], edgeTypeRows, 2, 'No graph edges.') %>
 
  <h3>Issue Overlay</h3>
  <%- dataTable(['Issue Type','ID','Target/Rule','Message'], issueRows, 4, 'No issues.') %>
</div>

<!-- Dynamic Vis.js Loader and API Sync logic -->
<script type="text/javascript">
  const rawGraph = <%- JSON.stringify(graph).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %>;

  const translationDict = {
    zh: {
      title: "系统拓扑依赖设计工作台 (Topology SPEC Workbench)",
      desc: "展示系统依赖拓扑与插槽绑定。支持节点拖拽、属性检查、添加Block、管脚连线绑定及一键实时热载重编译。",
      applyRecompileBtn: "应用变更并编译",
      inspectorTitle: "节点属性与配置 (Node Inspector)",
      coverageMatrixTitle: "架构覆盖率矩阵 (Graph Coverage Matrix)",
      coverageChartsTitle: "覆盖度仪表盘 (Coverage Dashboard)",
      covTitleBlocks: "能力块覆盖率",
      covTitleSlots: "插槽覆盖率",
      covTitleAcceptance: "验收测试用例",
      covTitlePolicy: "安全策略规则",
      covRatioLabel: "覆盖比例",
      covAcceptanceLabel: "验收节点",
      covActiveLabel: "活跃",
      covPolicyLabel: "安全约束",
      covEnforcedLabel: "强制执行",
      manualOverrideTitle: "人工接管审计 (Manual Override Registry)",
      manualOverrideDesc: "被开发人员物理手动覆盖的产物或配置文件。",
      summaryTitle: "拓扑节点与边摘要 (Summary)",
      sidebarBlocks: "可用能力块 (Blocks Catalog)",
      sidebarSlots: "可用插槽 (Slots Catalog)",
      enableWiring: "启用连线绑定",
      disableWiring: "退出连线模式",
      runNodeTest: "节点运行与调试",
      
      // Node types
      app: "主系统 (Application)",
      block: "能力块 (Block)",
      capability: "能力 (Capability)",
      pin: "引脚 (Pin)",
      slot: "插槽 (Slot)",
      file: "生成产物 (File)",
      acceptance: "验收测试 (Acceptance)",
      policy: "安全策略 (Policy)"
    },
    en: {
      title: "Topology SPEC Builder & Workbench",
      desc: "View and edit system dependency topologies and slot bindings. Support drag, inspect, block addition, slot bindings and hot compilation.",
      applyRecompileBtn: "Apply & Recompile",
      inspectorTitle: "Node Inspector",
      coverageMatrixTitle: "Graph Coverage Matrix",
      coverageChartsTitle: "Coverage Dashboard Charts",
      covTitleBlocks: "Blocks Coverage",
      covTitleSlots: "Slots Coverage",
      covTitleAcceptance: "Acceptance Tests",
      covTitlePolicy: "Policy Rules",
      covRatioLabel: "Coverage Ratio",
      covAcceptanceLabel: "Acceptance Nodes",
      covActiveLabel: "Active",
      covPolicyLabel: "Policy Constraints",
      covEnforcedLabel: "Enforced",
      manualOverrideTitle: "Manual Override Registry",
      manualOverrideDesc: "Tracked artifacts and nodes that have been manually overridden by developers.",
      summaryTitle: "Node & Edge Summary",
      sidebarBlocks: "Available Blocks",
      sidebarSlots: "Available Slots",
      enableWiring: "Enable Wiring Mode",
      disableWiring: "Disable Wiring Mode",
      runNodeTest: "Node Run & Debug",
      
      app: "Application",
      block: "Block",
      capability: "Capability",
      pin: "Pin",
      slot: "Slot",
      file: "Generated File",
      acceptance: "Acceptance",
      policy: "Policy"
    }
  };

  let currentLang = 'zh'; // Default Chinese
  let mutationsList = [];

  function toggleLanguage() {
    currentLang = currentLang === 'en' ? 'zh' : 'en';
    document.getElementById('lang-btn').textContent = currentLang === 'en' ? '中文' : 'English';
    applyTranslations();
    renderTopology();
  }

  function applyTranslations() {
    const langObj = translationDict[currentLang];
    document.querySelectorAll('[data-key]').forEach(el => {
      const key = el.getAttribute('data-key');
      if (langObj[key]) {
        el.textContent = langObj[key];
      }
    });
  }

  const policyViolations = <%- JSON.stringify(review.policySummary?.violationSummaries ?? policyReport.violations ?? []).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %>;
  const failurePoints = <%- JSON.stringify(review.failurePoints ?? []).replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %>;

  // Vis.js Graph colors mapping with premium glows
  const groupStyles = {
    app: { color: { background: '#1e293b', border: '#ef4444', highlight: { background: '#2d3748', border: '#f87171' } }, shape: 'box', borderWidth: 2 },
    block: { color: { background: '#064e3b', border: '#10b981', highlight: { background: '#047857', border: '#34d399' } }, shape: 'box', borderWidth: 2 },
    capability: { color: { background: '#1e3a8a', border: '#3b82f6', highlight: { background: '#1d4ed8', border: '#60a5fa' } }, shape: 'ellipse', borderWidth: 1 },
    pin: { color: { background: '#78350f', border: '#f59e0b', highlight: { background: '#b45309', border: '#fbbf24' } }, shape: 'triangle', borderWidth: 1 },
    slot: { color: { background: '#581c87', border: '#8b5cf6', highlight: { background: '#6b21a8', border: '#a78bfa' } }, shape: 'box', borderWidth: 2 },
    file: { color: { background: '#0f172a', border: '#475569', highlight: { background: '#1e293b', border: '#64748b' } }, shape: 'box', borderWidth: 1 },
    acceptance: { color: { background: '#831843', border: '#ec4899', highlight: { background: '#9d174d', border: '#f472b6' } }, shape: 'hexagon', borderWidth: 1 },
    policy: { color: { background: '#7c2d12', border: '#ea580c', highlight: { background: '#9a3412', border: '#f97316' } }, shape: 'database', borderWidth: 1 }
  };

  let network = null;
  let visNodes = null;
  let visEdges = null;
  let isWiringMode = false;

  // HTML5 Drag & Drop
  let draggedType = null;
  let draggedId = null;

  function handleDragStart(event, type, id) {
    draggedType = type;
    draggedId = id;
    event.dataTransfer.setData("text/plain", id);
  }

  function handleCanvasDrop(event) {
    event.preventDefault();
    if (!draggedType || !draggedId) return;

    const rect = document.getElementById('network-canvas').getBoundingClientRect();
    const x = event.clientX - rect.left;
    const y = event.clientY - rect.top;

    const canvasPosition = network.DOMtoCanvas({ x: x, y: y });
    addNewNodeAt(draggedType, draggedId, canvasPosition.x, canvasPosition.y);
    
    draggedType = null;
    draggedId = null;
  }

  function quickAddNode(type, id) {
    const viewPosition = network.getViewPosition();
    addNewNodeAt(type, id, viewPosition.x, viewPosition.y);
  }

  function addNewNodeAt(type, id, x, y) {
    if (type === 'block') {
      const blockId = id;
      const mutationId = `mut-block-add-${Date.now()}`;
      
      if (rawGraph.nodes.some(n => n.id === `block:${blockId}`) || mutationsList.some(m => m.kind === 'add-block' && m.blockId === blockId)) {
        alert(currentLang === 'zh' ? '该组件已经在画布中！' : 'This Block is already in canvas!');
        return;
      }
      
      mutationsList.push({
        id: mutationId,
        kind: 'add-block',
        blockId: blockId,
        version: '0.1.0'
      });
      
      if (visNodes) {
        visNodes.add({
          id: `block:${blockId}`,
          label: `${translationDict[currentLang].block}:\n${blockId} ⚠️`,
          x: x,
          y: y,
          ...groupStyles.block,
          color: {
            ...groupStyles.block.color,
            border: '#f59e0b',
            highlight: { border: '#f59e0b' }
          },
          shadow: {
            enabled: true,
            color: '#f59e0b',
            size: 10,
            x: 0,
            y: 0
          },
          font: { color: '#ffffff', size: 12, face: 'JetBrains Mono, monospace' }
        });
        
        const appNode = rawGraph.nodes.find(n => n.type === 'app');
        if (appNode) {
          visEdges.add({
            from: appNode.id,
            to: `block:${blockId}`,
            label: 'depends_on',
            arrows: 'to',
            color: { color: '#334155' }
          });
        }
      }
      updateMutationBadge();
    } else if (type === 'slot') {
      const slotId = id;
      if (visNodes) {
        if (visNodes.get(`slot:${slotId}`)) {
          alert(currentLang === 'zh' ? '该插槽已在画布中！' : 'This Slot is already in canvas!');
          return;
        }
        visNodes.add({
          id: `slot:${slotId}`,
          label: `${translationDict[currentLang].slot}:\n${slotId} ⚠️`,
          x: x,
          y: y,
          ...groupStyles.slot,
          color: {
            ...groupStyles.slot.color,
            border: '#f59e0b',
            highlight: { border: '#f59e0b' }
          },
          shadow: {
            enabled: true,
            color: '#f59e0b',
            size: 10,
            x: 0,
            y: 0
          },
          font: { color: '#ffffff', size: 12, face: 'JetBrains Mono, monospace' }
        });
      }
    }
  }

  function addCustomBlockFromSidebar() {
    const input = document.getElementById('custom-block-name');
    const val = input.value.trim();
    if (!val) return;
    quickAddNode('block', val);
    input.value = '';
  }

  function addCustomSlotFromSidebar() {
    const input = document.getElementById('custom-slot-name');
    const val = input.value.trim();
    if (!val) return;
    quickAddNode('slot', val);
    input.value = '';
  }

  function updateMutationBadge() {
    const badge = document.getElementById('status-badge');
    if (mutationsList.length > 0) {
      badge.textContent = currentLang === 'zh' ? `待应用修改 (${mutationsList.length})` : `Pending mutations (${mutationsList.length})`;
      badge.className = 'badge badge-attention';
    } else {
      badge.textContent = currentLang === 'zh' ? '工作台就绪' : 'Workbench Ready';
      badge.className = 'badge badge-info';
    }
  }

  function getNodeStatus(nodeId, type) {
    const hasMutation = mutationsList.some(m => 
      (m.kind === 'remove-block' && `block:${m.blockId}` === nodeId) ||
      (m.kind === 'bind-slot' && `slot:${m.slotId}` === nodeId) ||
      (m.kind === 'unbind-slot' && `slot:${m.slotId}` === nodeId)
    );
    if (hasMutation) return 'warning';

    for (const v of policyViolations) {
      if (v.appliesTo && v.appliesTo.includes(nodeId)) return 'failed';
      if (v.files && v.files.some(f => nodeId.includes(f))) return 'failed';
    }

    for (const f of failurePoints) {
      if (f.artifactPath && nodeId.includes(f.artifactPath)) return 'failed';
      if (f.message && f.message.includes(nodeId)) return 'failed';
    }

    return 'passed';
  }

  function renderTopology() {
    const nodesArray = rawGraph.nodes.map(n => {
      const typeStyle = groupStyles[n.type] || { color: { background: '#1e293b', border: '#475569' }, shape: 'box' };
      const prefix = translationDict[currentLang][n.type] || n.type;
      
      const state = getNodeStatus(n.id, n.type);
      
      let borderCol = typeStyle.color.border;
      let glowCol = 'rgba(0,0,0,0)';
      let badgeText = '';
      
      if (state === 'failed') {
        borderCol = '#ef4444';
        glowCol = '#ef4444';
        badgeText = ' ❌';
      } else if (state === 'warning') {
        borderCol = '#f59e0b';
        glowCol = '#f59e0b';
        badgeText = ' ⚠️';
      } else if (state === 'passed') {
        borderCol = '#10b981';
        glowCol = '#10b981';
        badgeText = ' ✅';
      }
      
      return {
        id: n.id,
        label: `${prefix}:\n${n.label}${badgeText}`,
        title: `Type: ${n.type}\nID: ${n.id}`,
        ...typeStyle,
        color: {
          ...typeStyle.color,
          border: borderCol,
          highlight: {
            ...typeStyle.color.highlight,
            border: borderCol
          }
        },
        shadow: {
          enabled: glowCol !== 'rgba(0,0,0,0)',
          color: glowCol,
          size: 10,
          x: 0,
          y: 0
        },
        margin: 10,
        font: { color: '#ffffff', size: 12, face: 'JetBrains Mono, monospace' }
      };
    });

    const edgesArray = rawGraph.edges.map(e => {
      const isConnection = e.type === 'connects_to';
      return {
        from: e.from,
        to: e.to,
        label: e.type,
        arrows: 'to',
        font: { color: '#94a3b8', size: 10, strokeWidth: 0, face: 'JetBrains Mono, monospace' },
        color: {
          color: isConnection ? '#8b5cf6' : '#334155',
          highlight: '#00f2fe',
          hover: '#00f2fe'
        },
        dashes: isConnection
      };
    });

    visNodes = new vis.DataSet(nodesArray);
    visEdges = new vis.DataSet(edgesArray);

    const container = document.getElementById('network-canvas');
    const data = { nodes: visNodes, edges: visEdges };
    const options = {
      physics: {
        forceAtlas2Based: {
          gravitationalConstant: -35,
          centralGravity: 0.01,
          springLength: 140,
          springConstant: 0.12
        },
        maxVelocity: 80,
        solver: 'forceAtlas2Based',
        timestep: 0.35,
        stabilization: { iterations: 120 }
      },
      interaction: {
        hover: true,
        tooltipDelay: 150,
        selectConnectedEdges: true,
        keyboard: false
      },
      manipulation: {
        enabled: false,
        addEdge: function(edgeData, callback) {
          if (edgeData.from === edgeData.to) {
            callback(null);
            return;
          }
          handleAddEdge(edgeData.from, edgeData.to, callback, edgeData);
        }
      }
    };

    network = new vis.Network(container, data, options);

    network.on("selectNode", function(params) {
      if (params.nodes.length > 0) {
        const nodeId = params.nodes[0];
        inspectNode(nodeId);
      }
    });

    network.on("deselectNode", function(params) {
      closeDrawer();
    });

    network.on("doubleClick", function(params) {
      if (params.nodes.length === 0 && params.edges.length === 0) {
        const pointer = params.pointer.canvas;
        const val = prompt(currentLang === 'zh' ? '双击空白处：请输入新建的 Block ID 或 Slot ID (Slot ID 请以 custom_ 开头):' : 'Double Click: Enter Block ID or Slot ID (Slot ID starts with "custom_"):');
        if (val) {
          const type = val.includes('/') || !val.includes('_') ? 'block' : 'slot';
          addNewNodeAt(type, val, pointer.x, pointer.y);
        }
      }
    });
  }

  function toggleWiringMode() {
    isWiringMode = !isWiringMode;
    const btn = document.getElementById('wiring-mode-btn');
    const text = document.getElementById('wiring-mode-text');
    
    if (isWiringMode) {
      btn.className = 'btn btn-primary';
      text.textContent = currentLang === 'zh' ? '退出连线模式' : 'Disable Wiring';
      network.addEdgeMode();
    } else {
      btn.className = 'btn btn-secondary';
      text.textContent = currentLang === 'zh' ? '启用连线模式' : 'Enable Wiring';
      network.disableEditMode();
    }
  }

  function handleAddEdge(fromId, toId, callback, edgeData) {
    const fromNode = rawGraph.nodes.find(n => n.id === fromId) || (visNodes.get(fromId) ? { id: fromId, type: fromId.split(':')[0] } : null);
    const toNode = rawGraph.nodes.find(n => n.id === toId) || (visNodes.get(toId) ? { id: toId, type: toId.split(':')[0] } : null);
    
    if (!fromNode || !toNode) {
      callback(null);
      return;
    }
    
    let blockNode = null;
    let slotNode = null;
    
    if (fromNode.type === 'block' && toNode.type === 'slot') {
      blockNode = fromNode;
      slotNode = toNode;
    } else if (fromNode.type === 'slot' && toNode.type === 'block') {
      blockNode = toNode;
      slotNode = fromNode;
    }
    
    if (!blockNode || !slotNode) {
      alert(currentLang === 'zh' ? '只允许在 Block 能力块与 Slot 插槽之间建立连线！' : 'Connections are only allowed between Block and Slot!');
      callback(null);
      if (isWiringMode) {
        setTimeout(() => network.addEdgeMode(), 100);
      }
      return;
    }
    
    const blockId = blockNode.id.replace('block:', '');
    const slotId = slotNode.id.replace('slot:', '');
    
    openDrawer();
    document.getElementById('inspector-title').textContent = currentLang === 'zh' ? '建立 Slot 绑定' : 'Bind Slot';
    
    const container = document.getElementById('inspector-content');
    container.innerHTML = `
      <div style="background: rgba(0, 242, 254, 0.1); border: 1px solid rgba(0, 242, 254, 0.3); padding: 12px; border-radius: 8px; margin-bottom: 16px;">
        <strong style="color: #00f2fe;">${currentLang === 'zh' ? '检测到管脚连线！' : 'Pin Wire Detected!'}</strong>
        <div style="font-size: 11px; margin-top: 4px; color: var(--text-muted);">
          Block: ${blockId} ➜ Slot: ${slotId}
        </div>
      </div>
      <div class="form-group">
        <label>${currentLang === 'zh' ? '源文件路径' : 'Source File Path'}</label>
        <input type="text" id="drag-bind-path" class="form-input" value="source/code/slots/${slotId}.ts" />
      </div>
      <div class="form-group">
        <label>${currentLang === 'zh' ? '导出符号名' : 'Export Symbol'}</label>
        <input type="text" id="drag-bind-symbol" class="form-input" value="handle${slotId.charAt(0).toUpperCase() + slotId.slice(1)}" />
      </div>
      <div class="form-group">
        <label>${currentLang === 'zh' ? '绑定描述' : 'Description'}</label>
        <input type="text" id="drag-bind-desc" class="form-input" placeholder="${currentLang === 'zh' ? '输入绑定逻辑说明' : 'Enter slot description'}" />
      </div>
      <div style="display: flex; gap: 8px; margin-top: 16px;">
        <button class="btn btn-primary" style="flex: 1; justify-content: center;" onclick="confirmWiringBinding('${slotId}', '${blockId}', callback, edgeData)">
          ${currentLang === 'zh' ? '确认绑定' : 'Confirm'}
        </button>
        <button class="btn btn-secondary" onclick="cancelWiringBinding(callback)">
          ${currentLang === 'zh' ? '取消' : 'Cancel'}
        </button>
      </div>
    `;
  }

  function confirmWiringBinding(slotId, blockId, callback, edgeData) {
    const path = document.getElementById('drag-bind-path').value.trim();
    const symbol = document.getElementById('drag-bind-symbol').value.trim();
    const desc = document.getElementById('drag-bind-desc').value.trim();
    
    if (!path || !symbol) {
      alert(currentLang === 'zh' ? '请填写完整绑定参数！' : 'Please fill out all fields!');
      return;
    }
    
    const mutationId = `mut-slot-bind-${Date.now()}`;
    mutationsList.push({
      id: mutationId,
      kind: 'bind-slot',
      slotId: slotId,
      block: blockId,
      slotKind: 'adapter',
      target: `custom/${slotId}.ts`,
      sourcePath: path,
      symbol: symbol,
      ...(desc ? { description: desc } : {})
    });
    
    edgeData.label = 'connects_to';
    edgeData.arrows = 'to';
    edgeData.color = { color: '#8b5cf6', highlight: '#00f2fe' };
    edgeData.font = { color: '#94a3b8', size: 10, face: 'JetBrains Mono, monospace' };
    edgeData.dashes = true;
    
    callback(edgeData);
    updateMutationBadge();
    
    // 更新 Slot 节点状态为 warning 状态并加上霓虹特效
    updateNodeVisualState(`slot:${slotId}`, 'warning');
    updateNodeVisualState(`block:${blockId}`, 'warning');
    
    closeDrawer();
    if (isWiringMode) {
      setTimeout(() => network.addEdgeMode(), 100);
    }
  }

  function cancelWiringBinding(callback) {
    callback(null);
    closeDrawer();
    if (isWiringMode) {
      setTimeout(() => network.addEdgeMode(), 100);
    }
  }

  function handleKeyboardDelete() {
    const selectedNodes = network.getSelectedNodes();
    const selectedEdges = network.getSelectedEdges();
    
    if (selectedNodes.length > 0) {
      const nodeId = selectedNodes[0];
      const type = nodeId.split(':')[0];
      if (type === 'block') {
        const blockId = nodeId.replace('block:', '');
        if (confirm(currentLang === 'zh' ? `确认卸载组件 ${blockId} 吗？` : `Are you sure you want to uninstall block ${blockId}?`)) {
          uninstallBlock(blockId);
        }
      } else if (type === 'slot') {
        const slotId = nodeId.replace('slot:', '');
        if (confirm(currentLang === 'zh' ? `确认解除插槽 ${slotId} 的绑定吗？` : `Are you sure you want to unbind slot ${slotId}?`)) {
          unbindSlot(slotId);
        }
      } else {
        alert(currentLang === 'zh' ? '只允许在画布上直接删除能力块 (Block) 或解绑插槽 (Slot) 节点！' : 'Only Block uninstallation and Slot unbinding are supported for deletion!');
      }
    } else if (selectedEdges.length > 0) {
      const edgeId = selectedEdges[0];
      const edge = visEdges.get(edgeId);
      if (edge && (edge.label === 'connects_to' || edge.dashes === true)) {
        let slotNodeId = edge.to.startsWith('slot:') ? edge.to : edge.from;
        const slotId = slotNodeId.replace('slot:', '');
        if (confirm(currentLang === 'zh' ? `确认断开插槽 ${slotId} 的连接绑定吗？` : `Are you sure you want to disconnect slot ${slotId}?`)) {
          unbindSlot(slotId);
          visEdges.remove(edgeId);
        }
      } else {
        alert(currentLang === 'zh' ? '只允许删除自定义插槽绑定 (connects_to) 连线！' : 'Only slot connection links (connects_to) can be disconnected!');
      }
    }
  }

  // Right Drawer Sidebar actions
  function openDrawer() {
    document.getElementById('inspector-drawer').classList.add('open');
  }

  function closeDrawer() {
    document.getElementById('inspector-drawer').classList.remove('open');
  }

  function inspectNode(nodeId) {
    const node = rawGraph.nodes.find(n => n.id === nodeId) || (visNodes.get(nodeId) ? { id: nodeId, type: nodeId.split(':')[0], label: nodeId.split(':')[1] } : null);
    if (!node) return;

    openDrawer();

    const container = document.getElementById('inspector-content');
    container.innerHTML = '';

    const titleVal = translationDict[currentLang][node.type] || node.type;
    document.getElementById('inspector-title').textContent = titleVal;

    const outgoing = rawGraph.edges.filter(e => e.from === nodeId);
    const incoming = rawGraph.edges.filter(e => e.to === nodeId);

    let html = `
      <div class="inspector-item">
        <div class="inspector-label">Node Type</div>
        <div class="inspector-value">${node.type}</div>
      </div>
      <div class="inspector-item">
        <div class="inspector-label">Unique ID</div>
        <div class="inspector-value">${node.id}</div>
      </div>
      <div class="inspector-item">
        <div class="inspector-label">Label</div>
        <div class="inspector-value" style="font-family: inherit;">${node.label}</div>
      </div>
    `;

    if (outgoing.length > 0) {
      html += `
        <div class="inspector-item">
          <div class="inspector-label">Depends On / Outgoing</div>
          <div style="display:flex; flex-direction:column; gap:4px; margin-top:4px;">
            ${outgoing.map(e => `<div class="badge badge-info" style="text-align:left;">➜ [${e.type}] ${e.to}</div>`).join('')}
          </div>
        </div>
      `;
    }

    if (incoming.length > 0) {
      html += `
        <div class="inspector-item">
          <div class="inspector-label">Referenced By / Incoming</div>
          <div style="display:flex; flex-direction:column; gap:4px; margin-top:4px;">
            ${incoming.map(e => `<div class="badge badge-success" style="text-align:left;">➜ [${e.type}] ${e.from}</div>`).join('')}
          </div>
        </div>
      `;
    }

    // Specific Node Type Forms / Controls
    if (node.type === 'block') {
      const blockId = nodeId.startsWith('block:') ? nodeId.slice(6) : nodeId;
      
      html += `
        <div style="border-top:1px solid #1e293b; padding-top:16px; margin-top:16px;">
          <h4 style="color:#00f2fe; margin-bottom:12px;">Block Operations</h4>
          <div class="form-group">
            <button class="btn btn-danger" style="width:100%; justify-content:center;" onclick="uninstallBlock('${blockId}')">
              Uninstall Block (卸载该组件)
            </button>
          </div>
        </div>
      `;
    } else if (node.type === 'slot') {
      const slotId = nodeId.startsWith('slot:') ? nodeId.slice(5) : nodeId;
      
      html += `
        <div style="border-top:1px solid #1e293b; padding-top:16px; margin-top:16px;">
          <h4 style="color:#00f2fe; margin-bottom:12px;">Slot Binding (配置管脚绑定)</h4>
          <div class="form-group">
            <label>Target Block Connection</label>
            <select id="sidebar-slot-block" class="form-select">
              ${rawGraph.nodes.filter(n => n.type === 'block').map(n => {
                const bId = n.id.slice(6);
                return `<option value="${bId}">${bId}</option>`;
              }).join('')}
            </select>
          </div>
          <div class="form-group">
            <label>Source File Path</label>
            <input type="text" id="sidebar-slot-path" class="form-input" value="source/code/slots/${slotId}.ts" />
          </div>
          <div class="form-group">
            <label>Symbol / Handler Name</label>
            <input type="text" id="sidebar-slot-symbol" class="form-input" value="handle${slotId.charAt(0).toUpperCase() + slotId.slice(1)}" />
          </div>
          <div class="form-group">
            <label>Description</label>
            <input type="text" id="sidebar-slot-desc" class="form-input" placeholder="Configure slot behavior" />
          </div>
          <div style="display:flex; gap:8px; margin-top:14px;">
            <button class="btn btn-primary" style="flex:1; justify-content:center;" onclick="bindSlotForm('${slotId}')">
              Save Bind
            </button>
            <button class="btn btn-danger" onclick="unbindSlot('${slotId}')">
              Unbind
            </button>
          </div>
        </div>
      `;
    }

    // Node Debugging Run Terminal
    if (node.type === 'block' || node.type === 'slot') {
      const runId = node.id.replace('block:', '').replace('slot:', '');
      html += `
        <div style="border-top:1px solid #1e293b; padding-top:16px; margin-top:16px;">
          <h4 style="color:#8b5cf6; margin-bottom:12px;" data-key="runNodeTest">Run & Debug (节点调试)</h4>
          <button class="btn btn-primary" style="width:100%; justify-content:center; background: linear-gradient(135deg, #8b5cf6, #d946ef);" onclick="runSingleNode('${node.type}', '${runId}')">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:4px;"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            Run Node Test / Verify
          </button>
          <div id="node-runner-console-container" style="display:none; margin-top:12px;">
            <div style="font-weight:600; color:#94a3b8; font-size:11px; text-transform:uppercase; margin-bottom:6px;">Runner Console</div>
            <div id="node-runner-console" style="background:#020617; border:1px solid #1e293b; border-radius:6px; font-family: 'JetBrains Mono', monospace; font-size:11px; color:#38bdf8; padding:10px; height:150px; overflow-y:auto; white-space:pre-wrap; box-sizing:border-box;"></div>
          </div>
        </div>
      `;
    }

    container.innerHTML = html;
  }

  // Mutations Operations Action triggers
  function uninstallBlock(blockId) {
    const mutationId = `mut-block-remove-${Date.now()}`;
    mutationsList.push({
      id: mutationId,
      kind: 'remove-block',
      blockId: blockId
    });
    
    if (visNodes) {
      try { visNodes.remove(`block:${blockId}`); } catch(e){}
    }
    
    updateMutationBadge();
    closeDrawer();
  }

  function bindSlotForm(slotId) {
    const block = document.getElementById('sidebar-slot-block').value;
    const path = document.getElementById('sidebar-slot-path').value.trim();
    const symbol = document.getElementById('sidebar-slot-symbol').value.trim();
    const desc = document.getElementById('sidebar-slot-desc').value.trim();
    const mutationId = `mut-slot-bind-${Date.now()}`;

    if (!path || !symbol) return;

    mutationsList.push({
      id: mutationId,
      kind: 'bind-slot',
      slotId: slotId,
      block: block,
      slotKind: 'adapter',
      target: `custom/${slotId}.ts`,
      sourcePath: path,
      symbol: symbol,
      ...(desc ? { description: desc } : {})
    });

    if (visNodes && visEdges) {
      // 移除原有的边（如果有的话）
      const existingEdges = visEdges.get({
        filter: function(item) {
          return item.to === `slot:${slotId}` && item.label === 'connects_to';
        }
      });
      if (existingEdges.length > 0) {
        visEdges.remove(existingEdges.map(e => e.id));
      }
      visEdges.add({
        from: `block:${block}`,
        to: `slot:${slotId}`,
        label: 'connects_to',
        arrows: 'to',
        color: { color: '#8b5cf6' },
        dashes: true
      });
    }

    updateNodeVisualState(`slot:${slotId}`, 'warning');
    updateNodeVisualState(`block:${block}`, 'warning');

    updateMutationBadge();
    closeDrawer();
  }

  function unbindSlot(slotId) {
    const mutationId = `mut-slot-unbind-${Date.now()}`;
    mutationsList.push({
      id: mutationId,
      kind: 'unbind-slot',
      slotId: slotId
    });

    if (visNodes && visEdges) {
      const existingEdges = visEdges.get({
        filter: function(item) {
          return item.to === `slot:${slotId}` && item.label === 'connects_to';
        }
      });
      if (existingEdges.length > 0) {
        visEdges.remove(existingEdges.map(e => e.id));
      }
    }

    updateNodeVisualState(`slot:${slotId}`, 'warning');
    updateMutationBadge();
    closeDrawer();
  }

  function updateNodeVisualState(nodeId, state) {
    if (!visNodes) return;
    
    let borderCol = '#475569';
    let glowCol = 'rgba(0,0,0,0)';
    let badgeText = '';
    
    if (state === 'passed') {
      borderCol = '#10b981';
      glowCol = '#10b981';
      badgeText = ' ✅';
    } else if (state === 'failed') {
      borderCol = '#ef4444';
      glowCol = '#ef4444';
      badgeText = ' ❌';
    } else if (state === 'warning') {
      borderCol = '#f59e0b';
      glowCol = '#f59e0b';
      badgeText = ' ⚠️';
    }
    
    const nodeData = visNodes.get(nodeId);
    if (nodeData) {
      let cleanLabel = nodeData.label.replace(/ [✅❌⚠️]/g, '');
      visNodes.update({
        id: nodeId,
        label: cleanLabel + badgeText,
        color: {
          border: borderCol,
          highlight: { border: borderCol }
        },
        shadow: {
          enabled: glowCol !== 'rgba(0,0,0,0)',
          color: glowCol,
          size: 12,
          x: 0,
          y: 0
        }
      });
    }
  }

  async function runSingleNode(type, id) {
    const consoleContainer = document.getElementById('node-runner-console-container');
    const runnerConsole = document.getElementById('node-runner-console');
    
    consoleContainer.style.display = 'block';
    runnerConsole.innerHTML = '';
    
    const divInit = document.createElement('div');
    divInit.style.color = '#38bdf8';
    divInit.textContent = `[Runner] Connecting to backend test runner for ${type} "${id}"...`;
    runnerConsole.appendChild(divInit);
    
    try {
      const res = await fetch('/api/run-node', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, id })
      });
      
      if (!res.ok) {
        throw new Error('Failed to contact test runner.');
      }
      
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';
        
        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const dataStr = line.slice(6);
            const span = document.createElement('div');
            if (dataStr.startsWith('[ERROR]')) {
              span.style.color = '#f87171';
            } else if (dataStr.includes('successfully') || dataStr.includes('passed')) {
              span.style.color = '#4ade80';
            } else {
              span.style.color = '#cbd5e1';
            }
            span.textContent = dataStr;
            runnerConsole.appendChild(span);
            runnerConsole.scrollTop = runnerConsole.scrollHeight;
          } else if (line.includes('event: success')) {
            updateNodeVisualState(type === 'block' ? `block:${id}` : `slot:${id}`, 'passed');
          } else if (line.includes('event: failure')) {
            updateNodeVisualState(type === 'block' ? `block:${id}` : `slot:${id}`, 'failed');
          }
        }
      }
    } catch(err) {
      const span = document.createElement('div');
      span.style.color = '#f87171';
      span.textContent = `[ERROR] Runner error: ${err.message || err}`;
      runnerConsole.appendChild(span);
    }
  }

  // Hot compile execution via fetch SSE stream
  function closeOverlay() {
    document.getElementById('stitching-overlay').classList.remove('active');
  }

  function appendTerminalLine(text, type = 'info') {
    const term = document.getElementById('terminal-screen');
    const div = document.createElement('div');
    div.className = `terminal-line ${type}`;
    div.textContent = text;
    term.appendChild(div);
    term.scrollTop = term.scrollHeight;
  }

  async function triggerHotCompile() {
    if (mutationsList.length === 0) {
      alert(currentLang === 'zh' ? '当前没有待保存的图形修改！' : 'No graph mutations to compile!');
      return;
    }

    const overlay = document.getElementById('stitching-overlay');
    const term = document.getElementById('terminal-screen');
    const overlayText = document.getElementById('overlay-text');
    const errorActions = document.getElementById('overlay-error-actions');

    term.innerHTML = '';
    errorActions.style.display = 'none';
    overlayText.textContent = 'Saving Mutations & Initiating Hot Compile...';
    overlay.classList.add('active');

    appendTerminalLine('POST /api/mutations - Saving active mutations...', 'info');

    try {
      const res = await fetch('/api/mutations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          formatVersion: "1",
          mutations: mutationsList
        })
      });
      if (!res.ok) {
        throw new Error('Failed to save mutations to server.');
      }
      appendTerminalLine('SUCCESS: Mutations written to source/views/mutations/graph-action.json', 'success');
    } catch(err) {
      appendTerminalLine(`[ERROR] ${err.message || err}`, 'error');
      overlayText.textContent = 'Mutation Sync Failed';
      errorActions.style.display = 'flex';
      return;
    }

    appendTerminalLine('POST /api/compile - Connecting to compiler engine progress stream...', 'info');
    overlayText.textContent = 'Compiling & Stitching Project...';

    try {
      const response = await fetch('/api/compile', { method: 'POST' });
      if (!response.ok) {
        throw new Error('Compile initialization endpoint failed.');
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const dataStr = line.slice(6);
            if (dataStr.startsWith('[ERROR]')) {
              appendTerminalLine(dataStr, 'error');
            } else if (dataStr.includes('successfully') || dataStr.includes('finished')) {
              appendTerminalLine(dataStr, 'success');
            } else {
              appendTerminalLine(dataStr, 'info');
            }
          } else if (line.includes('event: success')) {
            appendTerminalLine('SUCCESS: Redirection graph refreshed, reloading viewport in 1s...', 'success');
            overlayText.textContent = 'Compile Success!';
            setTimeout(() => {
              location.reload();
            }, 1000);
          } else if (line.includes('event: failure')) {
            appendTerminalLine('ERROR: Recompilation crashed. Please inspect logs above.', 'error');
            overlayText.textContent = 'Compile Failed';
            errorActions.style.display = 'flex';
          }
        }
      }
    } catch(err) {
      appendTerminalLine(`[ERROR] ${err.message || err}`, 'error');
      overlayText.textContent = 'Compile Failed';
      errorActions.style.display = 'flex';
    }
  }

  function retriggerCompile() {
    triggerHotCompile();
  }

  document.getElementById('recompile-btn').addEventListener('click', triggerHotCompile);
  document.getElementById('lang-btn').addEventListener('click', toggleLanguage);

  // 绑定全局键盘删除事件
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Delete' || e.key === 'Backspace') {
      if (document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'SELECT') {
        handleKeyboardDelete();
      }
    }
  });

  // Initialize page translations and network layout
  applyTranslations();
  renderTopology();
</script>
