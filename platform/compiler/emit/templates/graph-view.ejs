<%
  function countRows(values) {
    const counts = new Map();
    for (const value of values) {
      counts.set(value, (counts.get(value) ?? 0) + 1);
    }
    return [...counts.keys()].sort().map(function(key) { return [key, String(counts.get(key))]; });
  }

  const outgoingCounts = new Map();
  const incomingCounts = new Map();
  for (const edge of graph.edges) {
    outgoingCounts.set(edge.from, (outgoingCounts.get(edge.from) ?? 0) + 1);
    incomingCounts.set(edge.to, (incomingCounts.get(edge.to) ?? 0) + 1);
  }

  const nodeTypeCounts = new Map();
  for (const node of graph.nodes) {
    nodeTypeCounts.set(node.type, (nodeTypeCounts.get(node.type) ?? 0) + 1);
  }

  const nodeTypeRows = countRows(graph.nodes.map(function(node) { return node.type; }));
  const edgeTypeRows = countRows(graph.edges.map(function(edge) { return edge.type; }));
  const graphSummaryRows = [
    ['Nodes', String(graph.nodes.length)],
    ['Edges', String(graph.edges.length)],
    ['Node Types', String(nodeTypeRows.length)],
    ['Edge Types', String(edgeTypeRows.length)]
  ];
  const coverageRows = explainNodeTypes.map(function(type) {
    return [type, 'ExplainGraph node', 'node table + type detail', String(nodeTypeCounts.get(type) ?? 0)];
  }).concat([
    [
      'issue',
      'Review overlays',
      'policy violations + failure points + repair blockers + upgrade diagnostics',
      String(
        (review.policySummary?.violationSummaries?.length ?? policyReport.violations?.length ?? 0) +
        (review.failurePoints?.length ?? 0) +
        (review.repairSummary?.blockerSummaries?.length ?? 0) +
        (review.upgradeSummary?.diagnostics ? 1 : 0)
      )
    ]
  ]);
  const overridePaths = new Set(provenance.artifacts.filter(function(a) { return a.overrideStatus === 'manual'; }).map(function(a) { return a.path; }));
  const nodeRows = graph.nodes.map(function(node) {
    const rawId = node.id.startsWith('file:') ? node.id.slice(5) : node.id;
    const isOverride = overridePaths.has(rawId) || node.type === 'override' || node.id.startsWith('override:');
    const labelText = isOverride ? node.label + ' [Manual Override ⚠️]' : node.label;
    return [
      node.id,
      node.type,
      labelText,
      String(outgoingCounts.get(node.id) ?? 0),
      String(incomingCounts.get(node.id) ?? 0)
    ];
  });
  const nodeTypeDetailRows = explainNodeTypes.map(function(type) {
    return [
      type,
      formatList(graph.nodes.filter(function(node) { return node.type === type; }).map(function(node) { return node.id; }))
    ];
  });
  const edgeRows = graph.edges.map(function(edge) {
    return [edge.from, edge.type, edge.to];
  });
  const policyViolationSource = review.policySummary?.violationSummaries ?? policyReport.violations ?? [];
  const policyViolationRows = policyViolationSource.map(function(violation) {
    return [
      violation.id,
      violation.severity,
      violation.rule,
      formatList(violation.files),
      formatList(violation.appliesTo),
      violation.message
    ];
  });
  const issueRows = policyViolationRows.map(function(row) {
    return ['policy violation', row[0], row[2], row[5]];
  });
  for (const failurePoint of review.failurePoints ?? []) {
    issueRows.push(['failure point', failurePoint.lane + ':' + failurePoint.kind, failurePoint.artifactPath, failurePoint.message]);
  }
  for (const blocker of review.repairSummary?.blockerSummaries ?? []) {
    issueRows.push(['repair blocker', blocker.blockerId, blocker.boundary, blocker.reason + '; ' + blocker.decisionRequired]);
  }
  if (review.upgradeSummary?.diagnostics) {
    const diagnostics = review.upgradeSummary.diagnostics;
    issueRows.push(['upgrade diagnostic', diagnostics.errorCode, diagnostics.failedCheck, diagnostics.message]);
  }

  const overrideArtifacts = provenance.artifacts.filter(function(art) {
    return art.overrideStatus === 'manual';
  });
  const manualOverrideRows = overrideArtifacts.map(function(art) {
    return [
      art.path,
      art.originType,
      art.sourceBlock || 'none',
      'Manual Override ⚠️'
    ];
  });
  const overrideNodes = graph.nodes.filter(function(node) {
    return node.type === 'override';
  });
  for (const node of overrideNodes) {
    if (!overrideArtifacts.some(art => art.path === node.id || art.originId === node.id)) {
      manualOverrideRows.push([
        node.id,
        'override node',
        node.label,
        'Manual Override ⚠️'
      ]);
    }
  }

  const covSummary = review.coverageSummary;
  const blockPercent = covSummary && covSummary.blockCount ? Math.round((covSummary.coveredBlockCount / covSummary.blockCount) * 100) : 0;
  const slotPercent = covSummary && covSummary.slotCount ? Math.round((covSummary.coveredSlotCount / covSummary.slotCount) * 100) : 0;
