<%- include('helpers') %>
<%
  const runtimeGroups = new Map();
  for (const e of review.runtimeEntries) {
    const vertical = e.vertical ?? 'none';
    const key = vertical + ':' + e.kind;
    let g = runtimeGroups.get(key);
    if (!g) { g = { vertical: vertical, kind: e.kind, count: 0, relatedBlocks: new Set() }; runtimeGroups.set(key, g); }
    g.count += 1;
    for (const b of e.relatedBlocks) g.relatedBlocks.add(b);
  }
  const groupRows = [...runtimeGroups.values()].sort(function(a, b) { return a.vertical.localeCompare(b.vertical) || a.kind.localeCompare(b.kind); }).map(function(g) {
    return [g.vertical, g.kind, String(g.count), formatList(g.relatedBlocks)];
  });
  const entryRows = review.runtimeEntries.map(function(e) { return [e.kind, e.vertical ?? 'none', e.path, e.relatedBlocks.join(', ') || 'none']; });
%>
<section class="card">
  <h2>Review Runtime Attribution</h2>
  <%- subCard('Runtime Groups', dataTable(['Vertical','Kind','Count','Related Blocks'], groupRows, 4, 'No runtime groups in review summary.')) %>
  <%- subCard('Runtime Entries', dataTable(['Kind','Vertical','Path','Related Blocks'], entryRows, 4, 'No runtime entries in review summary.')) %>
</section>
