<%
  const artifactSummary = review.artifactSummary;
  const coverageSummary = review.coverageSummary;
  const policySummary = review.policySummary;
  const provenanceSummary = review.provenanceSummary;
  const repairSummary = review.repairSummary;
  const upgradeSummary = review.upgradeSummary;

  const dashboardRows = [
    ['CI Status', review.ciSummary.status],
    ['Failure Count', String(review.ciSummary.failureCount)],
    ['Regression Risks', String(review.ciSummary.regressionRiskCount)],
    ['Conflict Hints', String(review.ciSummary.conflictHintCount)],
    ['Chain Status', review.chainSummary.status],
    ['Chain Stages', review.chainSummary.passedStageCount + '/' + review.chainSummary.stageCount],
    ['Artifact Status', artifactSummary?.artifactStatus ?? 'passed'],
    ['Missing Artifacts', String(artifactSummary?.missingCount ?? 0)],
    ['Policy Status', policySummary?.status ?? policyReport.status],
    ['Coverage Status', coverageSummary?.status ?? 'unknown'],
    ['Repair Status', repairSummary?.status ?? 'none'],
    ['Upgrade Status', upgradeSummary?.status ?? 'none']
  ];

  const chainRows = review.chainSummary.stageSummaries.map(function(stage) {
    return [stage.id, stage.status, stage.detail];
  });

  const coverageRows = coverageSummary ? [
    ['Status', coverageSummary.status],
    ['Acceptance Passed', String(coverageSummary.acceptancePassedCount)],
    ['Covered Blocks', coverageSummary.coveredBlockCount + '/' + coverageSummary.blockCount],
    ['Covered Slots', coverageSummary.coveredSlotCount + '/' + coverageSummary.slotCount],
    ['Uncovered Blocks', formatList(coverageSummary.uncoveredBlocks)],
    ['Uncovered Slots', formatList(coverageSummary.uncoveredSlots)]
  ] : [];

  const policyMetricRows = policySummary ? [
    ['Status', policySummary.status],
    ['Official Policies', String(policySummary.officialPolicyCount)],
    ['Project Policies', String(policySummary.projectPolicyCount)],
    ['Merged Policies', String(policySummary.mergedPolicyCount)],
    ['Violations', String(policySummary.violationCount)]
  ] : [
    ['Status', policyReport.status],
    ['Official Policies', String(policyReport.official.sources.length)],
    ['Project Policies', String(policyReport.project.sources.length)],
    ['Merged Policies', String(policyReport.merged.policies.length)],
    ['Violations', String(policyReport.violations.length)]
  ];

  const policyViolationRows = (policySummary?.violationSummaries ?? policyReport.violations).map(function(violation) {
    return [
      violation.id,
      violation.severity,
      violation.rule ?? 'unknown',
      formatList(violation.files ?? []),
      formatList(violation.appliesTo ?? []),
      violation.message
    ];
  });

  const provenanceRows = provenanceSummary ? [
    ['Artifacts', String(provenanceSummary.artifactCount)],
    ['Verified Artifacts', String(provenanceSummary.verifiedArtifactCount)],
    ['Unverified Artifacts', String(provenanceSummary.unverifiedArtifactCount)],
    ['Override Artifacts', String(provenanceSummary.overrideArtifactCount)],
    ['Registry Artifacts', String(provenanceSummary.registryArtifactCount)],
    ['Generated Artifacts', String(provenanceSummary.generatedArtifactCount)]
  ] : [
    ['Artifacts', String(provenance.artifacts.length)],
    ['Verified Artifacts', String(provenance.artifacts.filter(function(artifact) { return artifact.verifiedBy.length > 0; }).length)],
    ['Unverified Artifacts', String(provenance.artifacts.filter(function(artifact) { return artifact.verifiedBy.length === 0; }).length)],
    ['Override Artifacts', String(provenance.artifacts.filter(function(artifact) { return artifact.overrideStatus !== 'none'; }).length)],
    ['Registry Artifacts', String(provenance.artifacts.filter(function(artifact) { return artifact.registrySourceId; }).length)],
    ['Generated Artifacts', String(provenance.artifacts.filter(function(artifact) { return artifact.originType === 'generated'; }).length)]
  ];

  const reviewFiles = [];
  function addReviewFile(path, reason) {
    if (path) {
      reviewFiles.push([path, reason]);
    }
  }
  for (const failurePoint of review.failurePoints) {
    addReviewFile(failurePoint.artifactPath, 'failure point: ' + failurePoint.lane + '/' + failurePoint.kind);
  }
  for (const missing of artifactSummary?.missing ?? []) {
    addReviewFile(missing.path, 'missing artifact: ' + missing.reason);
  }
  for (const path of provenanceSummary?.unverifiedArtifacts ?? []) {
    addReviewFile(path, 'unverified provenance');
  }
  for (const path of repairSummary?.targetFiles ?? []) {
    addReviewFile(path, 'repair target');
  }
  for (const path of upgradeSummary?.impacts ?? []) {
    addReviewFile(path, 'upgrade impact');
  }
  const reviewFileRows = uniqueSorted(reviewFiles.map(function(row) { return row[0] + '|' + row[1]; })).map(function(value) {
    const separator = value.indexOf('|');
    return [value.slice(0, separator), value.slice(separator + 1)];
  });

  const repairRows = repairSummary ? [
    ['Status', repairSummary.status],
    ['Source Verification', repairSummary.sourceVerificationStatus],
    ['Requires Verification', String(repairSummary.requiresVerification)],
    ['Tasks', String(repairSummary.taskCount)],
    ['Blockers', String(repairSummary.blockerCount)],
    ['Changed Previews', String(repairSummary.changedPreviewCount)],
    ['Failure Points', String(repairSummary.failurePointCount)],
    ['Trace Next Action', repairSummary.verificationTrace.nextAction]
  ] : [];
  const repairBlockerRows = (repairSummary?.blockerSummaries ?? []).map(function(blocker) {
    return [blocker.blockerId, blocker.boundary, blocker.reason, blocker.decisionRequired];
  });

  const upgradeRows = upgradeSummary ? [
    ['Status', upgradeSummary.status],
    ['Block', upgradeSummary.blockId],
    ['From Version', upgradeSummary.fromVersion ?? 'unknown'],
    ['To Version', upgradeSummary.toVersion],
    ['Preflight Checks', String(upgradeSummary.preflightCheckCount)],
    ['Migrations', String(upgradeSummary.migrationCount)],
    ['Operations', String(upgradeSummary.migrationOperationCount)],
    ['Impacts', String(upgradeSummary.impactCount)],
    ['Requires Verification', String(upgradeSummary.requiresVerification)]
  ] : [];
  const upgradeDiagnosticRows = upgradeSummary?.diagnostics ? [[
    upgradeSummary.diagnostics.phase ?? 'planning',
    upgradeSummary.diagnostics.failedCheck,
    upgradeSummary.diagnostics.errorCode,
    upgradeSummary.diagnostics.message,
    upgradeSummary.diagnostics.details === undefined ? 'none' : JSON.stringify(upgradeSummary.diagnostics.details)
  ]] : [];

  const artifactRows = artifactSummary ? [
    ['Status', artifactSummary.artifactStatus ?? 'passed'],
    ['Artifacts', String(artifactSummary.artifactCount)],
    ['Governance Artifacts', String(artifactSummary.governanceCount)],
    ['View Artifacts', String(artifactSummary.viewCount)],
    ['Contract Artifacts', String(artifactSummary.contractCount ?? 0)],
    ['Upload Groups', String(artifactSummary.uploadGroupCount ?? artifactSummary.uploadGroups?.length ?? 0)],
    ['Missing Artifacts', String(artifactSummary.missingCount)],
    ['Missing Reason Types', String(artifactSummary.missingReasonTypeCount ?? countPositiveValues(Object.values(artifactSummary.missingReasonCounts ?? {})))]
  ] : [];
%>
<section class="card">
  <h1>Review View</h1>
  <p>Human review dashboard derived from governance evidence.</p>
</section>
<section class="card">
  <h2>Review Dashboard</h2>
  <%- metricTable(dashboardRows) %>
</section>
<section class="card">
  <h2>Verification Chain</h2>
  <%- dataTable(['Stage','Status','Detail'], chainRows, 3, 'No verification chain stages.') %>
</section>
<section class="card">
  <h2>Acceptance Coverage</h2>
  <%- metricTable(coverageRows) %>
</section>
<section class="card">
  <h2>Policy Summary</h2>
  <%- metricTable(policyMetricRows) %>
  <%- subCard('Policy Violations', dataTable(['Policy','Severity','Rule','Files','Applies To','Message'], policyViolationRows, 6, 'No policy violations.')) %>
</section>
<section class="card">
  <h2>Provenance Summary</h2>
  <%- metricTable(provenanceRows) %>
  <%- subCard('Review File Priorities', dataTable(['Path','Reason'], reviewFileRows, 2, 'No priority files.')) %>
</section>
<section class="card">
  <h2>Repair Readiness</h2>
  <%- metricTable(repairRows) %>
  <%- subCard('Repair Blockers', dataTable(['Blocker','Boundary','Reason','Decision Required'], repairBlockerRows, 4, 'No repair blockers.')) %>
</section>
<section class="card">
  <h2>Upgrade Readiness</h2>
  <%- metricTable(upgradeRows) %>
  <%- subCard('Upgrade Diagnostics', dataTable(['Phase','Failed Check','Error','Message','Details'], upgradeDiagnosticRows, 5, 'No upgrade diagnostics.')) %>
</section>
<section class="card">
  <h2>Artifact Readiness</h2>
  <%- metricTable(artifactRows) %>
  <%- subCard('Missing Artifacts', dataTable(['Path','Reason','Declared By'], artifactSummary?.missing?.map(function(missing) { return [missing.path, missing.reason, missing.declaredBy]; }) ?? [], 3, 'No missing artifacts.')) %>
</section>
