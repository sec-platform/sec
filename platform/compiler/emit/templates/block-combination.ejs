<% await include('helpers') %>
<%
  const impactByBlock = new Map(review.installImpacts.map(function(i) { return [i.blockId, i]; }));
  const blockRows = lock.resolvedBlocks.slice().sort(function(a, b) { return a.installOrder - b.installOrder || a.id.localeCompare(b.id); }).map(function(block) {
    const installs = countMatching(lock.installPlan, function(step) { return step.blockId === block.id; });
    const impact = impactByBlock.get(block.id);
    return [block.id, block.kind, String(block.installOrder), String(installs), impact?.verticals.join(', ') || 'none', impact?.runtimeEntries.join(', ') || 'none'];
  });
%>
<section class="card">
  <h2>Block Combination Summary</h2>
  <%- dataTable(['Block','Kind','Install Order','Install Steps','Verticals','Runtime Entries'], blockRows, 6, 'No blocks installed.') %>
</section>
