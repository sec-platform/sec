<% await include('helpers') %>
<%
  const failureRows = review.failurePoints.map(function(f) { return [f.lane, f.kind, f.artifactPath, f.message]; });
  const regressionRows = review.regressionRisks.map(function(r) { return [r.kind, r.blockId ?? '', r.slotId ?? '', r.message]; });
  const conflictRows = review.conflictHints.map(function(h) { return [h.kind, h.relatedId, h.message]; });
%>
<section class="card">
  <h2>Review Failure Points</h2>
  <%- dataTable(['Lane','Kind','Artifact','Message'], failureRows, 4, 'No failure points.') %>
</section>
<section class="card">
  <h2>Review Regression Risks</h2>
  <%- dataTable(['Kind','Block','Slot','Message'], regressionRows, 4, 'No regression risks.') %>
</section>
<section class="card">
  <h2>Review Conflict Hints</h2>
  <%- dataTable(['Kind','Related ID','Message'], conflictRows, 3, 'No conflict hints.') %>
</section>
