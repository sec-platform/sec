<% await include('helpers') %>
<section class="card">
  <h1>Slot / Rule View</h1>
  <p>Fast lane: <%- esc(report.fast.status) %> | Runtime lane: <%- esc(report.runtime.status) %> | Overall: <%- esc(report.summary.status) %></p>
  <table>
    <thead><tr><th>Slot</th><th>Block</th><th>Source</th><th>Runtime Target</th><th>Status</th><th>Coverage</th></tr></thead>
    <tbody>
      <% lock.slotTasks.forEach(function(task) { %>
      <% const slotCoverage = coverage.slots.find(function(e) { return e.id === task.id; }); %>
      <tr>
        <td><%- esc(task.id) %></td>
        <td><%- esc(task.block) %></td>
        <td><%- esc(task.sourcePath ?? 'compatibility target only') %></td>
        <td><%- esc(task.target) %></td>
        <td><%- esc(task.status) %></td>
        <td><%- esc((slotCoverage?.coveredBy ?? []).join(', ') || 'none') %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</section>
<section class="card">
  <%- (await include('ci-summary', { ...viewHelpers, review: review, countPositiveValues: countPositiveValues, buildE2eMatrix: buildE2eMatrix })).toString().replace(/<section class="card">/g, '').replace(/<\/section>/g, '') %>
</section>
<%- await include('policy-tables', { ...viewHelpers, policyReport: policyReport }) %>
<section class="card"><h2>Acceptance Coverage</h2><pre><%- esc(JSON.stringify(coverage, null, 2)) %></pre></section>
<%- await include('review-tables', { ...viewHelpers, review: review }) %>
