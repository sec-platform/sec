<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - SpecEngineer Workbench</title>
    <!-- Import Premium Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg-main: #080c14;
        --bg-card: rgba(19, 25, 38, 0.7);
        --bg-input: #1b2336;
        --border-color: rgba(255, 255, 255, 0.08);
        --text-main: #f1f5f9;
        --text-muted: #94a3b8;
        --accent-blue: #00f2fe;
        --accent-green: #10b981;
        --accent-purple: #8b5cf6;
        --accent-orange: #f59e0b;
        --accent-red: #ef4444;
      }

      /* Premium dark custom scrollbar design */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: rgba(8, 12, 20, 0.5);
      }
      ::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
        border: 2px solid #080c14;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: rgba(0, 242, 254, 0.3);
      }

      body {
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
        background: var(--bg-main);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        background-image: 
          radial-gradient(at 0% 0%, rgba(139, 92, 246, 0.08) 0px, transparent 50%),
          radial-gradient(at 100% 100%, rgba(0, 242, 254, 0.06) 0px, transparent 50%);
        background-attachment: fixed;
        overflow: <%= currentNav === 'graph' ? 'hidden' : 'auto' %>;
        width: 100vw;
        height: 100vh;
        box-sizing: border-box;
      }

      /* Unified Floating Glassmorphic Topbar Navigation */
      .floating-topbar {
        position: fixed;
        top: 16px;
        left: 2%;
        width: 96%;
        height: 52px;
        z-index: 1000;
        background: rgba(13, 20, 38, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        box-sizing: border-box;
        transition: all 0.3s ease;
      }

      .topbar-logo {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .logo-pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #00f2fe;
        box-shadow: 0 0 12px #00f2fe;
        animation: pulse-glow 2s infinite;
      }
      @keyframes pulse-glow {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.2); opacity: 0.6; }
      }
      .logo-text {
        font-family: 'Outfit', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }
      .topbar-desc {
        color: #64748b;
        font-size: 9px;
        margin: 0;
        font-family: 'Outfit', sans-serif;
        font-weight: 500;
      }

      /* Unified Floating Navigation Tabs */
      .topbar-tabs {
        display: flex;
        gap: 4px;
        background: rgba(0, 0, 0, 0.2);
        padding: 3px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.05);
      }
      .topbar-tab {
        font-family: 'Outfit', sans-serif;
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
        background: none;
        border: none;
        padding: 6px 14px;
        border-radius: 16px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
      }
      .topbar-tab:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.03);
      }
      .topbar-tab.active, .topbar-tab[aria-current="page"] {
        color: #090d16;
        background: linear-gradient(135deg, #00f2fe, #4facfe);
        box-shadow: 0 2px 8px rgba(0, 242, 254, 0.3);
      }

      /* Topbar Actions Panel */
      .topbar-actions {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .btn {
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        font-size: 11px;
        border: none;
        border-radius: 18px;
        padding: 6px 14px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 30px;
        box-sizing: border-box;
      }
      .btn-primary {
        background: linear-gradient(135deg, #00f2fe, #4facfe);
        color: #090d16;
        box-shadow: 0 2px 8px rgba(0, 242, 254, 0.2);
      }
      .btn-primary:hover {
        box-shadow: 0 4px 15px rgba(0, 242, 254, 0.4);
        transform: translateY(-1px);
      }
      .btn-secondary {
        background: rgba(255, 255, 255, 0.06);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }
      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.12);
        transform: translateY(-1px);
      }

      /* Main layout wrappers (Branching based on Nav) */
      .centered-main {
        max-width: 1400px;
        margin: 0 auto;
        padding: 92px 24px 60px 24px;
        display: grid;
        gap: 28px;
        box-sizing: border-box;
        z-index: 1;
        position: relative;
      }

      .fullscreen-main {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Premium Card & Table styling */
      .card {
        background: var(--bg-card);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
        position: relative;
        overflow: hidden;
        transition: transform 0.25s, box-shadow 0.25s;
      }
      .card:hover {
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
      }
      .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
      }
      h1, h2, h3, h4 {
        font-family: 'Outfit', sans-serif;
        color: #ffffff;
        margin-top: 0;
      }
      h1 { font-size: 26px; font-weight: 700; }
      h2 { font-size: 20px; font-weight: 600; margin-bottom: 16px; border-left: 4px solid var(--accent-blue); padding-left: 10px; }
      h3 { font-size: 16px; font-weight: 600; }
      
      pre {
        overflow: auto;
        background: #030712;
        color: #a5f3fc;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        line-height: 1.6;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 12px;
        font-size: 13px;
      }
      th {
        font-family: 'Outfit', sans-serif;
        text-transform: uppercase;
        font-size: 10px;
        letter-spacing: 1px;
        color: var(--text-muted);
        background: rgba(0, 0, 0, 0.3);
        padding: 12px 16px;
        border-bottom: 2px solid var(--border-color);
        text-align: left;
      }
      td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--border-color);
        vertical-align: middle;
        color: var(--text-main);
      }
      tr:hover td {
        background: rgba(255, 255, 255, 0.015);
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
      }

      /* Utility Badge Styles */
      .badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 600;
        font-family: 'JetBrains Mono', monospace;
      }
      .badge-success { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); border: 1px solid rgba(16, 185, 129, 0.3); }
      .badge-attention { background: rgba(245, 158, 11, 0.15); color: var(--accent-orange); border: 1px solid rgba(245, 158, 11, 0.3); }
      .badge-failed { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); border: 1px solid rgba(239, 68, 68, 0.3); }
      .badge-info { background: rgba(0, 242, 254, 0.15); color: var(--accent-blue); border: 1px solid rgba(0, 242, 254, 0.3); }
    </style>
  </head>
  <body>
    <!-- Unified Immersive Floating Navigation Bar -->
    <div class="floating-topbar">
      <div class="topbar-logo">
        <span class="logo-pulse"></span>
        <div>
          <span class="logo-text">SpecEngineer Workbench</span>
          <p class="topbar-desc">Industrial Control & Stitching Console</p>
        </div>
      </div>

      <!-- Center Double Tabs (Now 5 sub-views Double-Tab navigation) -->
      <div class="topbar-tabs">
        <a href="overview-view.html" class="topbar-tab<%= currentNav === 'overview' ? ' active' : '' %>">Overview</a>
        <a href="source-view.html" class="topbar-tab<%= currentNav === 'source' ? ' active' : '' %>">Source View</a>
        <a href="slot-rule-view.html" class="topbar-tab<%= currentNav === 'slot-rule' ? ' active' : '' %>">Slot / Rule View</a>
        <a href="graph-view.html" class="topbar-tab<%= currentNav === 'graph' ? ' active' : '' %>">Graph View</a>
        <a href="review-view.html" class="topbar-tab<%= currentNav === 'review' ? ' active' : '' %>">Review View</a>
      </div>

      <!-- Right dynamic Actions menu (Interlocks with currentNav or EJS scripting) -->
      <% if (currentNav === 'graph') { %>
        <div class="topbar-actions">
          <span class="badge badge-info" id="status-badge">Ready</span>
          <button class="btn btn-secondary" id="wiring-mode-btn" onclick="toggleWiringMode()">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span id="wiring-mode-text" data-key="enableWiring">Enable Wiring</span>
          </button>
          <button class="btn btn-primary" id="recompile-btn" data-key="applyRecompileBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            Apply & Recompile
          </button>
          <button class="btn btn-secondary" id="lang-btn">English</button>
        </div>
      <% } else { %>
        <div class="topbar-actions">
          <button class="btn btn-secondary" id="lang-btn" onclick="typeof toggleLanguage !== 'undefined' ? toggleLanguage() : (location.href = location.href)">Language</button>
        </div>
      <% } %>
    </div>

    <!-- Main Viewport Router Container -->
    <main class="<%= currentNav === 'graph' ? 'fullscreen-main' : 'centered-main' %>">
      <%- body %>
    </main>
  </body>
</html>

