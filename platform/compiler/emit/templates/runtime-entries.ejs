<%- include('helpers') %>
<%
  const runtimeEntries = [];
  for (const gp of lock.generatedPaths) {
    const kind = classifyRuntimeEntry(gp);
    if (kind) runtimeEntries.push({ path: gp, kind: kind });
  }
  const rtRows = runtimeEntries.map(function(e) { return [e.kind, e.path]; });
%>
<section class="card">
  <h2>Runtime Entry Points</h2>
  <%- dataTable(['Kind','Path'], rtRows, 2, 'No generated runtime entries.') %>
</section>
