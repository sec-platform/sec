<%- include('helpers') %>
<%
  const is = review.installImpactSummary;
  const summaryRows = [
    ['Impacts', String(is.impactCount)],
    ['Blocks', String(is.blockCount)],
    ['Action Kinds', String(is.actionKindCount)],
    ['Source Roots', String(is.sourceRootCount)],
    ['Target Paths', String(is.targetPathCount)],
    ['Verticals', String(is.verticalCount)],
    ['Runtime Entries', String(is.runtimeEntryCount)],
    ['Groups', String(is.groupCount)]
  ];
  const groupRows = is.groupSummaries.map(function(g) { return [g.vertical, String(g.blockCount), formatList(g.actionKinds), formatList(g.runtimeEntries), formatList(g.targetPaths)]; });
  const impactRows = review.installImpacts.map(function(i) { return [i.blockId, i.actionKinds.join(', ') || 'none', i.sourceRoots.join(', ') || 'none', i.verticals.join(', ') || 'none', i.runtimeEntries.join(', ') || 'none', i.targetPaths.join(', ') || 'none']; });
%>
<section class="card">
  <h2>Install Impact Summary</h2>
  <%- metricTable(summaryRows) %>
  <%- subCard('Impact Groups', dataTable(['Vertical','Blocks','Actions','Runtime Entries','Targets'], groupRows, 5, 'No install impact groups in review summary.')) %>
  <%- subCard('Impact Details', dataTable(['Block','Actions','Sources','Verticals','Runtime Entries','Targets'], impactRows, 6, 'No install impacts in review summary.')) %>
</section>
