<%- include('helpers') %>
<%
  function taxonomyRows(entries) { return entries.map(function(e) { return [e.id, String(e.count)]; }); }
%>
<% if (review.repairSummary) { const r = review.repairSummary; %>
<section class="card">
  <h2>Repair Summary</h2>
  <%- metricTable([
    ['Status', r.status], ['Source Verification', r.sourceVerificationStatus],
    ['Requires Verification', String(r.requiresVerification)], ['Tasks', String(r.taskCount)],
    ['Blockers', String(r.blockerCount)], ['Previews', String(r.previewCount)],
    ['Changed Previews', String(r.changedPreviewCount)], ['Failure Points', String(r.failurePointCount)],
    ['Trace Pending Reason', r.verificationTrace.pendingReason], ['Trace Next Action', r.verificationTrace.nextAction],
    ['Target Files', r.targetFiles.join(', ') || 'none']
  ]) %>
  <h3>Repair Failure Taxonomy</h3>
  <div class="grid">
    <%- dataTable(['Lane','Count'], taxonomyRows(r.failureTaxonomy.laneSummaries), 2, 'No failure lanes.') %>
    <%- dataTable(['Kind','Count'], taxonomyRows(r.failureTaxonomy.kindSummaries), 2, 'No failure kinds.') %>
    <%- dataTable(['Issue Type','Count'], taxonomyRows(r.failureTaxonomy.issueTypeSummaries), 2, 'No issue types.') %>
    <%- dataTable(['Repairability','Count'], taxonomyRows(r.failureTaxonomy.repairabilitySummaries), 2, 'No repairability states.') %>
  </div>
  <%- subCard('Repair Task Category Summary', dataTable(['Category','Count'], taxonomyRows(r.taskCategorySummaries), 2, 'No repair task categories.')) %>
  <%- subCard('Repair Target Attribution Summary', dataTable(['Type','Target','Count'], r.targetSummaries.map(function(t) { return [t.targetType, t.id, String(t.count)]; }), 3, 'No repair target attribution.')) %>
  <%- subCard('Repair Task Summary', dataTable(['Task','Category','Preview','Delta','Failure Points','Write Bounds','Symbols','Tests','Failure Targets'], r.taskSummaries.map(function(t) { return [t.taskId, t.category, t.previewStatus, t.addedLines + '/-' + t.removedLines, String(t.failurePointCount), t.writeBounds.join(', ') || 'none', t.requiredSymbols.join(', ') || 'none', t.testsToPass.join(', ') || 'none', t.failureTargets.join(', ') || 'none']; }), 9, 'No repair tasks.')) %>
  <%- subCard('Repair Blocker Summary', dataTable(['Blocker','Boundary','Failure Points','Reason'], r.blockerSummaries.map(function(b) { return [b.blockerId, b.boundary, String(b.failurePointCount), b.reason]; }), 4, 'No repair blockers.')) %>
</section>
<% } %>

<% if (repairPlan) { %>
<section class="card">
  <h2>Repair Plan</h2>
  <p><%= esc(repairPlan.status) %> | source verification: <%= esc(repairPlan.sourceVerificationStatus) %> | requires verification: <%= esc(String(repairPlan.requiresVerification)) %></p>
  <% if (repairPlan.blockers?.length) { %>
    <%- subCard('Blockers', dataTable(['Blocker','Boundary','Reason','Decision Required'], repairPlan.blockers.map(function(b) { return [b.blockerId, b.boundary, b.reason, b.decisionRequired]; }), 4, 'No blockers.')) %>
  <% } %>
  <%- dataTable(['Task','Category','Slot','Block','Target File','Allowed Paths','Required Symbols','Forbidden Operations','Failure Summary','Failure Targets','Preview'], repairPlan.tasks.map(function(t) {
    const preview = t.preview ? (t.preview.changed ? 'changed' : 'unchanged') + '; +' + t.preview.addedLines + '/-' + t.preview.removedLines + '; ' + t.preview.beforeLines + ' -> ' + t.preview.afterLines + ' lines' : '';
    const targets = t.failurePoints.flatMap(function(p) { return p.targetIds ?? []; }).join(', ');
    return [t.taskId, t.category ?? 'slot-rewrite', t.sourceSlotId, t.targetBlock, t.targetFile, t.allowedPaths.join(', '), t.requiredSymbols.join(', '), t.forbiddenOperations.join(', '), t.failureSummary, targets, preview];
  }), 11, 'No repair tasks.') %>
</section>
<% } %>
